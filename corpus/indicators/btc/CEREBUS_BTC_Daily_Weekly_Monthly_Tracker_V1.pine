    float q25 = na
    float q50 = na
    float q75 = na
    float q90 = na
    if cur == "USD" and fam == "CPI"
        if h == 15
            q25:=357.4, q50:=598.8, q75:=977.1, q90:=1417.7
        else if h == 30
            q25:=453.4, q50:=651.0, q75:=1065.5, q90:=1511.7
        else if h == 60
            q25:=464.4, q50:=829.7, q75:=1373.1, q90:=1721.1
        else
            q25:=565.0, q50:=1318.5, q75:=2026.0, q90:=2501.2
