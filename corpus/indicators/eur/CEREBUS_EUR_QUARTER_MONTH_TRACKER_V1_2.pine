//@version=6
indicator("CEREBUS EUR Quarter / Month Tracker V1.2", overlay=true, max_lines_count=400, max_labels_count=300)

// ============================================================================
// CEREBUS EUR QUARTER / MONTH TRACKER V1.2
// Higher-order quarter/month distribution engine + M1 seed + modern L2/L3 setup states.
// Purpose: destination + regime tracking. Not a full Game matrix.
// Weekly and Daily engines remain independent by design.
// Time basis: America/New_York.
// ============================================================================

// ------------------------------- Inputs -------------------------------------
string TZ = input.string("America/New_York", "Timezone")
bool showLevels = input.bool(true, "Show M1 Fib / Rekey Levels", group="Display")
bool showExtensions = input.bool(true, "Show M1 Directional Extensions", group="Display")
bool showMainTable = input.bool(true, "Show Main Dashboard", group="Display")
bool showValidation = input.bool(true, "Show Validation Panel", group="Display")
int rollingN = input.int(16, "Rolling completed quarters", minval=4, maxval=40, group="Validation")

// M1 D1-D3 Seed Engine (new in V1.1).
bool showSeedMap = input.bool(true, "Show M1 D1-D3 Seed Map", group="M1 D1-D3 Seed")
bool showSeedExtensions = input.bool(true, "Show Seed Continuation Targets", group="M1 D1-D3 Seed")
bool showSeedReloadZone = input.bool(true, "Shade 25-50% Reload Zone", group="M1 D1-D3 Seed")
bool showSeedDeepMap = input.bool(false, "Show Deep 68-168% Seed Rekey Map", group="M1 D1-D3 Seed")
bool showSeedLabels = input.bool(true, "Show Candidate Seed Labels", group="M1 D1-D3 Seed")
string seedConfirmTF = input.string("H1 close", "Seed break confirmation", options=["Touch", "Chart close", "H1 close"], group="M1 D1-D3 Seed")

// Modern Layer 2 setup bridge (from CEREBUS Weekly Engine V1.1).
bool showL2Setup = input.bool(true, "Show L2 Weekly Setup", group="Layer 2 Weekly Setup")
bool showL2Levels = input.bool(false, "Plot Weekly Thirds", group="Layer 2 Weekly Setup")
bool showL2Labels = input.bool(true, "Show L2 Setup Labels", group="Layer 2 Weekly Setup")
float l2T1Max = input.float(20.0, "L2 T1 Monday Asian Max (pips)", step=0.1, group="Layer 2 Weekly Setup")
float l2T2Max = input.float(30.0, "L2 T2 Monday Asian Max (pips)", step=0.1, group="Layer 2 Weekly Setup")
float l2T3Max = input.float(45.0, "L2 T3 / No-Go Max (pips)", step=0.1, group="Layer 2 Weekly Setup")

// Legacy survivors are never promoted to core setup status without enough N.
bool showLegacyFlags = input.bool(false, "Show Legacy Research Flags", group="Research Flags")
float legacyMacroT1 = input.float(108.1, "Legacy Macro T1 D1-D3 max (pips)", step=0.1, group="Research Flags")

// Historical long-run M1 -> final-quarter range multiples.
float HIST_Q50 = input.float(1.64, "Historical Q50 × M1", step=0.01, group="Quarter Range")
float HIST_Q75 = input.float(2.26, "Historical Q75 × M1", step=0.01, group="Quarter Range")
float HIST_Q90 = input.float(2.83, "Historical Q90 × M1", step=0.01, group="Quarter Range")

// Frozen / research-reference M1 D1-D3 statistics.
float SEED_Q_DIR_FROZEN = 69.5
float SEED_M1_DIR = 72.9
float SEED_DIR_FIRST = 67.8
float SEED_DIR_FIRST_MED_RUN = 1.12
float SEED_DIR_FIRST_MEAN_RUN = 1.34
float SEED_T25 = 82.5
float SEED_T50 = 67.5
float SEED_T85 = 60.0
float SEED_T100 = 55.0
float SEED_T132 = 42.5
float SEED_T168 = 32.5

// Legacy ablation references (tested against the newer framework).
// Weekly Coiled Spring: N=7 recent signals; +0.50 MR continuation 7/7, +1.00 6/7. Small-N flag only.
// Old Exhausted Snap failed midpoint delivery and is parked.
// Macro compressed D1-D3 seed (<=108.1p): N=16 long-history; D3->Q 81.3%, M2 >= +1.0 seed range 81.3%.
float LEGACY_COMPRESSED_QDIR = 81.3
float LEGACY_COMPRESSED_M2_1X = 81.3

// ------------------------------ Helpers -------------------------------------
f_pct(float x) => na(x) ? "—" : str.tostring(x, "#.0") + "%"
f_num(float x) => na(x) ? "—" : str.tostring(x, "#.2")
f_pips(float x) => na(x) ? na : x / syminfo.mintick / 10.0
f_rate(int wins, int n) => n <= 0 ? na : 100.0 * wins / n
f_rate_text(int wins, int n) => n <= 0 ? "—" : str.tostring(100.0 * wins / n, "#.1") + "% (" + str.tostring(wins) + "/" + str.tostring(n) + ")"

f_state_bin(float x) =>
    na(x) ? -1 :
     x < 0 ? 0 :
     x < 25 ? 1 :
     x < 50 ? 2 :
     x < 68 ? 3 :
     x < 80 ? 4 :
     x < 100 ? 5 :
     x < 110 ? 6 :
     x < 120 ? 7 :
     x < 132 ? 8 :
     x < 168 ? 9 : 10

f_state_name(int b) =>
    switch b
        0 => "<0 CONTINUATION"
        1 => "0–25"
        2 => "25–50 PULLBACK"
        3 => "50–68 FAILURE"
        4 => "68–80 DEEP FAILURE"
        5 => "80–100 OPP BOUNDARY"
        6 => "100–110 SNAP AOI"
        7 => "110–120 LAST RECOVERY"
        8 => "120–132 DEEP REKEY"
        9 => "132–168 CONFIRMED"
        10 => "168+ OUTER"
        => "WAIT"

f_percentile_nearest(float[] a, float p) =>
    int n = array.size(a)
    if n == 0
        na
    else
        float[] c = array.copy(a)
        array.sort(c, order.ascending)
        int idx = math.max(0, math.min(n - 1, int(math.ceil((p / 100.0) * n)) - 1))
        array.get(c, idx)

// OOS benchmark for M3 checkpoint cell: returns [wins, n].
f_oos_cell(int checkpoint, int b) =>
    int w = 0
    int n = 0
    if checkpoint == 3
        if b == 0
            w := 3
            n := 4
        else if b == 1
            w := 0
            n := 1
        else if b == 2
            w := 1
            n := 1
        else if b == 3
            w := 1
            n := 3
        else if b == 4
            w := 1
            n := 1
        else if b == 5
            w := 1
            n := 2
        else if b == 7
            w := 1
            n := 1
        else if b == 8
            w := 0
            n := 1
    else if checkpoint == 5
        if b == 0
            w := 3
            n := 4
        else if b == 1
            w := 1
            n := 1
        else if b == 2
            w := 1
            n := 2
        else if b == 3
            w := 0
            n := 1
        else if b == 4
            w := 0
            n := 1
        else if b == 5
            w := 2
            n := 2
        else if b == 6
            w := 0
            n := 1
        else if b == 8
            w := 1
            n := 2
    [w, n]

f_table_pos(string s) =>
    switch s
        "Top Left" => position.top_left
        "Top Center" => position.top_center
        "Top Right" => position.top_right
        "Middle Left" => position.middle_left
        "Middle Center" => position.middle_center
        "Middle Right" => position.middle_right
        "Bottom Left" => position.bottom_left
        "Bottom Center" => position.bottom_center
        => position.bottom_right

string mainPosInput = input.string("Top Right", "Main table position", options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display")
string valPosInput = input.string("Bottom Right", "Validation panel position", options=["Top Left","Top Center","Top Right","Middle Left","Middle Center","Middle Right","Bottom Left","Bottom Center","Bottom Right"], group="Display")

