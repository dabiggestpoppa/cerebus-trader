f_wlookup(float[] arr, int hourState, int tierState) =>
    int h = math.max(1, math.min(96, hourState))
    int t = math.max(1, math.min(3, tierState))
    int idx = (h - 1) * 3 + (t - 1)
    array.get(arr, idx)

// ---------------------------- Calendar state --------------------------------
int yy = year(time, TZ)
int mm = month(time, TZ)
int dd = dayofmonth(time, TZ)
int qNum = int(math.floor((mm - 1) / 3)) + 1
int qId = yy * 10 + qNum
int monthPos = ((mm - 1) % 3) + 1
bool newDay = dd != dayofmonth(time[1], TZ) or mm != month(time[1], TZ) or yy != year(time[1], TZ)
bool newMonth = mm != month(time[1], TZ) or yy != year(time[1], TZ)
bool newQuarter = qId != (year(time[1], TZ) * 10 + int(math.floor((month(time[1], TZ) - 1) / 3)) + 1)

// ------------------------- Layer 2 live weekly state ------------------------
int l2Dow = dayofweek(time, TZ)
int l2Hour = hour(time, TZ)
int l2Minute = minute(time, TZ)
bool l2Sun19 = l2Dow == dayofweek.sunday and l2Hour == 19 and l2Minute == 0
bool l2Mon03 = l2Dow == dayofweek.monday and l2Hour == 3 and l2Minute == 0
bool l2InMonAsian = (l2Dow == dayofweek.sunday and l2Hour >= 19) or (l2Dow == dayofweek.monday and l2Hour < 3)

var float l2WeekHigh = na
var float l2WeekLow = na
var float l2ARHigh = na
var float l2ARLow = na
var float l2ARPips = na
var bool l2ARLocked = false

if l2Sun19
    l2WeekHigh := high
    l2WeekLow := low
    l2ARHigh := high
    l2ARLow := low
    l2ARPips := na
    l2ARLocked := false
else
    if not na(l2WeekHigh)
        l2WeekHigh := math.max(l2WeekHigh, high)
        l2WeekLow := math.min(l2WeekLow, low)

if l2InMonAsian
    l2ARHigh := na(l2ARHigh) ? high : math.max(l2ARHigh, high)
    l2ARLow := na(l2ARLow) ? low : math.min(l2ARLow, low)

if l2Mon03 and not l2ARLocked and not na(l2ARHigh) and not na(l2ARLow)
    l2ARPips := f_pips(l2ARHigh - l2ARLow)
    l2ARLocked := true
if not l2ARLocked and l2Dow == dayofweek.monday and l2Hour >= 3 and not na(l2ARHigh) and not na(l2ARLow)
    l2ARPips := f_pips(l2ARHigh - l2ARLow)
    l2ARLocked := true

int l2Tier = na(l2ARPips) ? 0 : l2ARPips < l2T1Max ? 1 : l2ARPips < l2T2Max ? 2 : l2ARPips <= l2T3Max ? 3 : 4
string l2TierTxt = l2Tier == 1 ? "T1" : l2Tier == 2 ? "T2" : l2Tier == 3 ? "T3" : l2Tier == 4 ? "NO-GO" : "BUILD"

int l2DayOffset = l2Dow == dayofweek.sunday ? 0 : l2Dow == dayofweek.monday ? 1 : l2Dow == dayofweek.tuesday ? 2 : l2Dow == dayofweek.wednesday ? 3 : l2Dow == dayofweek.thursday ? 4 : l2Dow == dayofweek.friday ? 5 : 6
int l2HourFromSun19 = l2DayOffset * 24 + l2Hour - 19
if l2HourFromSun19 < 0
    l2HourFromSun19 += 168
int l2WeekHour = math.max(1, math.min(96, l2HourFromSun19 + 1))

float l2PrintedPips = not na(l2WeekHigh) and not na(l2WeekLow) ? f_pips(l2WeekHigh - l2WeekLow) : na
float l2Loc = not na(l2WeekHigh) and not na(l2WeekLow) and l2WeekHigh > l2WeekLow ? (close - l2WeekLow) / (l2WeekHigh - l2WeekLow) : na
string l2LocState = na(l2Loc) ? "—" : l2Loc < 1.0/3.0 ? "LOWER" : l2Loc > 2.0/3.0 ? "UPPER" : "MIDDLE"
bool l2Ready = l2Tier >= 1 and l2Tier <= 3 and l2WeekHour >= 1 and l2WeekHour <= 96
float l2Median = l2Ready ? f_wlookup(MEDIAN_RANGE, l2WeekHour, l2Tier) : na
float l2Sigma = l2Ready ? f_wlookup(ROBUST_SIGMA, l2WeekHour, l2Tier) : na
float l2RemainQ50 = l2Ready ? f_wlookup(REMAIN_MEDIAN, l2WeekHour, l2Tier) : na
float l2PAny = l2Ready ? f_wlookup(P_ANY_EXTREME, l2WeekHour, l2Tier) : na
float l2Z = l2Ready and l2Sigma > 0 ? (l2PrintedPips - l2Median) / l2Sigma : na
string l2Pace = na(l2Z) ? "—" : l2Z < -1.0 ? "BEHIND" : l2Z <= 1.0 ? "NORMAL" : l2Z <= 2.0 ? "AHEAD" : "EXTREME"

int l2Mins = (l2Dow - dayofweek.sunday) * 1440 + l2Hour * 60 + l2Minute
int l2Tue12M = (dayofweek.tuesday - dayofweek.sunday) * 1440 + 12 * 60
int l2Wed03M = (dayofweek.wednesday - dayofweek.sunday) * 1440 + 3 * 60
int l2Wed12M = (dayofweek.wednesday - dayofweek.sunday) * 1440 + 12 * 60
int l2Checkpoint = l2Mins >= l2Wed12M ? 3 : l2Mins >= l2Wed03M ? 2 : l2Mins >= l2Tue12M ? 1 : 0
bool l2Prime = l2Dow == dayofweek.wednesday and l2Hour >= 3 and l2Hour < 12
bool l2TierPrime = l2Tier == 1 ? (l2WeekHour >= 58 and l2WeekHour <= 60) : l2Tier == 2 ? (l2WeekHour >= 64 and l2WeekHour <= 67) : l2Tier == 3 ? (l2WeekHour >= 58 and l2WeekHour <= 62) : false
bool l2Exhaustion = l2LocState == "MIDDLE" and (l2Pace == "AHEAD" or l2Pace == "EXTREME")
bool l2HealthyPace = l2Pace == "BEHIND" or l2Pace == "NORMAL"

float l2PHigh = na
float l2PLow = na
if l2Checkpoint == 1
    if l2LocState == "LOWER"
        l2PHigh := 38.6
        l2PLow := 88.6
    else if l2LocState == "UPPER"
        l2PHigh := 80.6
        l2PLow := 25.0
    else if l2LocState == "MIDDLE"
        l2PHigh := 59.5
        l2PLow := 57.1
else if l2Checkpoint == 2
    if l2LocState == "LOWER"
        l2PHigh := 22.2
        l2PLow := 91.1
    else if l2LocState == "UPPER"
        l2PHigh := 87.9
        l2PLow := 9.1
    else if l2LocState == "MIDDLE"
        l2PHigh := 59.1
        l2PLow := 54.5
else if l2Checkpoint == 3
    if l2LocState == "LOWER"
        l2PHigh := 19.1
        l2PLow := 78.7
    else if l2LocState == "UPPER"
        l2PHigh := 73.3
        l2PLow := 11.1
    else if l2LocState == "MIDDLE"
        l2PHigh := 36.7
        l2PLow := 43.3

string l2Setup = "L2 WAIT"
string l2Target = "—"
if l2Tier == 4
    l2Setup := "L2 NO-GO"
else if l2Ready
    if l2Exhaustion
        l2Setup := "L2 EXHAUSTION / NO EDGE"
        l2Target := "STAND DOWN"
    else if l2Prime and l2TierPrime and l2HealthyPace and l2LocState == "UPPER"
        l2Setup := "L2 PRIME RELOAD LONG"
        l2Target := "NEW WEEK HIGH"
    else if l2Prime and l2TierPrime and l2HealthyPace and l2LocState == "LOWER"
        l2Setup := "L2 PRIME RELOAD SHORT"
        l2Target := "NEW WEEK LOW"
    else if l2Checkpoint > 0 and l2LocState == "UPPER" and not l2Exhaustion
        l2Setup := "L2 UPPER-THIRD CONT"
        l2Target := "NEW WEEK HIGH"
    else if l2Checkpoint > 0 and l2LocState == "LOWER" and not l2Exhaustion
        l2Setup := "L2 LOWER-THIRD CONT"
        l2Target := "NEW WEEK LOW"
    else
        l2Setup := "L2 NEUTRAL / WAIT"

float l2LowerThird = not na(l2WeekLow) and not na(l2WeekHigh) ? l2WeekLow + (l2WeekHigh-l2WeekLow)/3.0 : na
float l2UpperThird = not na(l2WeekLow) and not na(l2WeekHigh) ? l2WeekLow + 2.0*(l2WeekHigh-l2WeekLow)/3.0 : na
plot(showL2Levels ? l2LowerThird : na, "L2 Weekly Lower Third", color=color.new(color.red,60), style=plot.style_linebr)
plot(showL2Levels ? l2UpperThird : na, "L2 Weekly Upper Third", color=color.new(color.lime,60), style=plot.style_linebr)

// ------------------------- Quarter working state -----------------------------
var float qOpen = na
var float qHigh = na
var float qLow = na
var int qDay = 0
var int d3Dir = 0
var bool d3Locked = false

// M1 D1-D3 seed geometry. 0% = directional edge, 100% = opposite edge.
var float seedOpen = na
var float seedHigh = na
var float seedLow = na
var float seedClose = na
var float seedRange = na
var float seedDirEdge = na
var float seedOppEdge = na
var int seedBreakFirst = 0     // 0 waiting, +1 directional first, -1 opposite first
var bool seedBreakConfirmed = false
var bool seedReloadTagged = false

var float m1Open = na
var float m1Close = na
var float m1High = na
var float m1Low = na
var int m1Dir = 0
var float m1Range = na
var float m1DirEdge = na
var float m1OppEdge = na
var bool m1Locked = false

var float m2High = na
var float m2Low = na
var float m3High = na
var float m3Low = na
var bool m2BreakM1 = false
var int m2Day = 0
var int m3Day = 0
var int m3D3Bin = -1
var int m3D5Bin = -1

// Rolling completed-quarter record queues.
var int[] rollD3Correct = array.new_int()
var int[] rollAlignCorrect = array.new_int()   // -1 = no alignment event
var int[] rollM2Break = array.new_int()
var int[] rollD3Bin = array.new_int()
var int[] rollD5Bin = array.new_int()
var int[] rollM3Owner = array.new_int()
var float[] rollM1Mult = array.new_float()

// ---------------------------- Finalize quarter -------------------------------
if newQuarter and not na(qOpen)
    float prevQClose = close[1]
    int prevQDir = prevQClose >= qOpen ? 1 : -1
    int owner = 0
    if prevQDir == 1
        float mx = math.max(nz(m1High, -1e10), math.max(nz(m2High, -1e10), nz(m3High, -1e10)))
        owner := math.abs(nz(m3High) - mx) <= syminfo.mintick * 2 ? 3 : math.abs(nz(m2High) - mx) <= syminfo.mintick * 2 ? 2 : 1
    else
        float mn = math.min(nz(m1Low, 1e10), math.min(nz(m2Low, 1e10), nz(m3Low, 1e10)))
        owner := math.abs(nz(m3Low) - mn) <= syminfo.mintick * 2 ? 3 : math.abs(nz(m2Low) - mn) <= syminfo.mintick * 2 ? 2 : 1

    int d3ok = d3Dir == 0 ? -1 : (d3Dir == prevQDir ? 1 : 0)
    int alignok = (d3Dir != 0 and m1Dir != 0 and d3Dir == m1Dir) ? (m1Dir == prevQDir ? 1 : 0) : -1
    int m3own = owner == 3 ? 1 : 0

    array.push(rollD3Correct, d3ok)
    array.push(rollAlignCorrect, alignok)
    array.push(rollM2Break, m2BreakM1 ? 1 : 0)
    array.push(rollD3Bin, m3D3Bin)
    array.push(rollD5Bin, m3D5Bin)
    array.push(rollM3Owner, m3own)
    if not na(m1Range) and m1Range > 0
        float finalQRange = qHigh - qLow
        array.push(rollM1Mult, finalQRange / m1Range)

    while array.size(rollD3Correct) > rollingN
        array.shift(rollD3Correct)
    while array.size(rollAlignCorrect) > rollingN
        array.shift(rollAlignCorrect)
    while array.size(rollM2Break) > rollingN
        array.shift(rollM2Break)
    while array.size(rollD3Bin) > rollingN
        array.shift(rollD3Bin)
    while array.size(rollD5Bin) > rollingN
        array.shift(rollD5Bin)
    while array.size(rollM3Owner) > rollingN
        array.shift(rollM3Owner)
    while array.size(rollM1Mult) > rollingN
        array.shift(rollM1Mult)

    // reset for new quarter
    qOpen := open
    qHigh := high
    qLow := low
    qDay := 1
    d3Dir := 0
    d3Locked := false
    seedOpen := open
    seedHigh := high
    seedLow := low
    seedClose := na
    seedRange := na
    seedDirEdge := na
    seedOppEdge := na
    seedBreakFirst := 0
    seedBreakConfirmed := false
    seedReloadTagged := false
    m1Open := open
    m1Close := na
    m1High := high
    m1Low := low
    m1Dir := 0
    m1Range := na
    m1DirEdge := na
    m1OppEdge := na
    m1Locked := false
    m2High := na
    m2Low := na
    m3High := na
    m3Low := na
    m2BreakM1 := false
    m2Day := 0
    m3Day := 0
    m3D3Bin := -1
    m3D5Bin := -1
else if na(qOpen)
    qOpen := open
    qHigh := high
    qLow := low
    qDay := 1
    seedOpen := open
    seedHigh := high
    seedLow := low
    m1Open := open
    m1High := high
    m1Low := low

// Update quarter extremes.
qHigh := math.max(nz(qHigh, high), high)
qLow := math.min(nz(qLow, low), low)

// Day counter and first-3-day direction / range lock.
// Lock at the first bar of D4 BEFORE adding that bar to the D1-D3 seed range.
if newDay and not newQuarter
    if qDay == 3 and not d3Locked
        seedClose := close[1]
        d3Dir := seedClose >= seedOpen ? 1 : -1
        seedRange := seedHigh - seedLow
        seedDirEdge := d3Dir == 1 ? seedHigh : seedLow
        seedOppEdge := d3Dir == 1 ? seedLow : seedHigh
        d3Locked := true
    qDay += 1

if qDay <= 3 and not d3Locked
    seedHigh := math.max(nz(seedHigh, high), high)
    seedLow := math.min(nz(seedLow, low), low)

// ------------------------- M1 D1-D3 Seed Engine ----------------------------
f_seed_rekey(float pct) =>
    not d3Locked or na(seedRange) or seedRange <= 0 ? na : d3Dir == 1 ? seedDirEdge - seedRange * (pct / 100.0) : seedDirEdge + seedRange * (pct / 100.0)

f_seed_ext(float mult) =>
    not d3Locked or na(seedRange) or seedRange <= 0 ? na : d3Dir == 1 ? seedDirEdge + seedRange * mult : seedDirEdge - seedRange * mult

float sd25 = f_seed_rekey(25)
float sd50 = f_seed_rekey(50)
float sd68 = f_seed_rekey(68)
float sd80 = f_seed_rekey(80)
float sd100 = f_seed_rekey(100)
float sd110 = f_seed_rekey(110)
float sd120 = f_seed_rekey(120)
float sd132 = f_seed_rekey(132)
float sd168 = f_seed_rekey(168)
float sx25 = f_seed_ext(0.25)
float sx50 = f_seed_ext(0.50)
float sx85 = f_seed_ext(0.85)
float sx100 = f_seed_ext(1.00)
float sx132 = f_seed_ext(1.32)
float sx168 = f_seed_ext(1.68)

// Research used first touch to classify which side broke first.
if monthPos == 1 and d3Locked and seedBreakFirst == 0
    bool dirTouch = d3Dir == 1 ? high > seedDirEdge : low < seedDirEdge
    bool oppTouch = d3Dir == 1 ? low < seedOppEdge : high > seedOppEdge
    if dirTouch and not oppTouch
        seedBreakFirst := 1
    else if oppTouch and not dirTouch
        seedBreakFirst := -1

// Optional live confirmation state. H1 close is evaluated with request.security.
float h1Close = request.security(syminfo.tickerid, "60", close, barmerge.gaps_off, barmerge.lookahead_off)
bool dirTouchNow = d3Locked and (d3Dir == 1 ? high > seedDirEdge : low < seedDirEdge)
bool chartCloseBeyond = d3Locked and (d3Dir == 1 ? close > seedDirEdge : close < seedDirEdge)
bool h1CloseBeyond = d3Locked and (d3Dir == 1 ? h1Close > seedDirEdge : h1Close < seedDirEdge)
bool seedBreakTrigger = seedConfirmTF == "Touch" ? dirTouchNow : seedConfirmTF == "Chart close" ? chartCloseBeyond : h1CloseBeyond
if monthPos == 1 and d3Locked and not seedBreakConfirmed and seedBreakTrigger
    seedBreakConfirmed := true

// Candidate reload tag: after a confirmed directional break, price revisits 25-50% of seed range
// and closes back through the 25% node in the seed direction. This is a plotted research candidate,
// not a validated trading rule.
bool seedReloadTouch = d3Locked and seedBreakConfirmed and (d3Dir == 1 ? low <= sd25 and low >= math.min(sd50, sd25) : high >= sd25 and high <= math.max(sd50, sd25))
bool seedReloadRecover = d3Locked and (d3Dir == 1 ? close > sd25 : close < sd25)
bool seedReloadCandidate = monthPos == 1 and not seedReloadTagged and seedReloadTouch and seedReloadRecover
if seedReloadCandidate
    seedReloadTagged := true

// ----------------------------- Month 1 --------------------------------------
if monthPos == 1
    m1High := math.max(nz(m1High, high), high)
    m1Low := math.min(nz(m1Low, low), low)

if newMonth and monthPos == 2 and not m1Locked
    m1Close := close[1]
    m1Dir := m1Close >= m1Open ? 1 : -1
    m1Range := m1High - m1Low
    m1DirEdge := m1Dir == 1 ? m1High : m1Low
    m1OppEdge := m1Dir == 1 ? m1Low : m1High
    m1Locked := true
    m2Day := 1

// ----------------------------- Month 2 --------------------------------------
if monthPos == 2 and m1Locked
    m2High := math.max(nz(m2High, high), high)
    m2Low := math.min(nz(m2Low, low), low)
    m2BreakM1 := m2BreakM1 or high > m1High or low < m1Low
    if newDay and not newMonth
        m2Day += 1

// ----------------------------- Month 3 --------------------------------------
f_norm(float px) =>
    not m1Locked or na(m1Range) or m1Range <= 0 ? na :
     m1Dir == 1 ? 100.0 * (m1DirEdge - px) / m1Range : 100.0 * (px - m1DirEdge) / m1Range

if newMonth and monthPos == 3
    m3Day := 1
    m3High := high
    m3Low := low

if monthPos == 3 and m1Locked
    m3High := math.max(nz(m3High, high), high)
    m3Low := math.min(nz(m3Low, low), low)
    if newDay and not newMonth
        // Lock prior day's checkpoint at the first bar of the next trading day.
        if m3Day == 3 and m3D3Bin < 0
            m3D3Bin := f_state_bin(f_norm(close[1]))
        if m3Day == 5 and m3D5Bin < 0
            m3D5Bin := f_state_bin(f_norm(close[1]))
        m3Day += 1

// ----------------------------- Levels ---------------------------------------
f_rekey_level(float pct) =>
    not m1Locked ? na : m1Dir == 1 ? m1DirEdge - m1Range * (pct / 100.0) : m1DirEdge + m1Range * (pct / 100.0)

f_ext_level(float pct) =>
    not m1Locked ? na : m1Dir == 1 ? m1DirEdge + m1Range * (pct / 100.0) : m1DirEdge - m1Range * (pct / 100.0)

float lv25 = f_rekey_level(25)
float lv50 = f_rekey_level(50)
float lv68 = f_rekey_level(68)
float lv80 = f_rekey_level(80)
float lv100 = f_rekey_level(100)
float lv110 = f_rekey_level(110)
float lv120 = f_rekey_level(120)
float lv132 = f_rekey_level(132)
float lv168 = f_rekey_level(168)
float ex25 = f_ext_level(25)
float ex50 = f_ext_level(50)
float ex85 = f_ext_level(85)

plot(showLevels ? m1DirEdge : na, "M1 Directional Edge", color=color.new(color.aqua, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels ? lv25 : na, "M1 25", color=color.new(color.yellow, 25), style=plot.style_linebr)
plot(showLevels ? lv50 : na, "M1 50", color=color.new(color.yellow, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels ? lv68 : na, "M1 68", color=color.new(color.orange, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels ? lv80 : na, "M1 80", color=color.new(color.red, 15), style=plot.style_linebr)
plot(showLevels ? lv100 : na, "M1 100", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels ? lv110 : na, "M1 110", color=color.new(color.fuchsia, 10), style=plot.style_linebr)
plot(showLevels ? lv120 : na, "M1 120", color=color.new(color.fuchsia, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels ? lv132 : na, "M1 132", color=color.new(color.purple, 0), linewidth=2, style=plot.style_linebr)
plot(showLevels ? lv168 : na, "M1 168", color=color.new(color.purple, 25), style=plot.style_linebr)
plot(showExtensions ? ex25 : na, "M1 -25", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)
plot(showExtensions ? ex50 : na, "M1 -50", color=color.new(color.lime, 20), style=plot.style_linebr)
plot(showExtensions ? ex85 : na, "M1 -85", color=color.new(color.lime, 40), style=plot.style_linebr)

// --------------------------- Seed Map Plots ---------------------------------
bool seedVisible = monthPos == 1 and d3Locked
plot(showSeedMap and seedVisible ? seedDirEdge : na, "Seed D1-D3 Directional Edge", color=#d4af37, linewidth=3, style=plot.style_linebr)
plot(showSeedMap and seedVisible ? seedOppEdge : na, "Seed D1-D3 Opposite Edge", color=color.new(color.aqua, 10), linewidth=2, style=plot.style_linebr)

pSeed25 = plot(showSeedMap and seedVisible ? sd25 : na, "Seed 25%", color=color.new(#d4af37, 35), style=plot.style_linebr)
pSeed50 = plot(showSeedMap and seedVisible ? sd50 : na, "Seed 50%", color=color.new(#d4af37, 5), linewidth=2, style=plot.style_linebr)
fill(pSeed25, pSeed50, color=showSeedReloadZone and seedVisible ? color.new(#d4af37, 87) : na, title="Seed 25-50 Reload Zone")

plot(showSeedDeepMap and seedVisible ? sd68 : na, "Seed 68%", color=color.new(color.orange, 15), style=plot.style_linebr)
plot(showSeedDeepMap and seedVisible ? sd80 : na, "Seed 80%", color=color.new(color.orange, 0), style=plot.style_linebr)
plot(showSeedDeepMap and seedVisible ? sd100 : na, "Seed 100%", color=color.new(color.red, 0), linewidth=2, style=plot.style_linebr)
plot(showSeedDeepMap and seedVisible ? sd110 : na, "Seed 110%", color=color.new(color.fuchsia, 15), style=plot.style_linebr)
plot(showSeedDeepMap and seedVisible ? sd120 : na, "Seed 120%", color=color.new(color.fuchsia, 0), style=plot.style_linebr)
plot(showSeedDeepMap and seedVisible ? sd132 : na, "Seed 132%", color=color.new(color.purple, 0), linewidth=2, style=plot.style_linebr)
plot(showSeedDeepMap and seedVisible ? sd168 : na, "Seed 168%", color=color.new(color.purple, 30), style=plot.style_linebr)

plot(showSeedExtensions and seedVisible ? sx25 : na, "Seed +0.25x", color=color.new(color.lime, 0), linewidth=2, style=plot.style_linebr)
plot(showSeedExtensions and seedVisible ? sx50 : na, "Seed +0.50x", color=color.new(color.lime, 10), linewidth=2, style=plot.style_linebr)
plot(showSeedExtensions and seedVisible ? sx85 : na, "Seed +0.85x", color=color.new(color.lime, 25), style=plot.style_linebr)
plot(showSeedExtensions and seedVisible ? sx100 : na, "Seed +1.00x", color=color.new(color.green, 0), linewidth=2, style=plot.style_linebr)
plot(showSeedExtensions and seedVisible ? sx132 : na, "Seed +1.32x", color=color.new(color.green, 30), style=plot.style_linebr)
plot(showSeedExtensions and seedVisible ? sx168 : na, "Seed +1.68x", color=color.new(color.green, 55), style=plot.style_linebr)

plotshape(showSeedLabels and monthPos == 1 and seedBreakConfirmed and not seedBreakConfirmed[1], title="Seed Directional Break Candidate", style=shape.labelup, location=location.belowbar, color=#d4af37, textcolor=color.black, size=size.tiny, text="SEED BREAK")
plotshape(showSeedLabels and seedReloadCandidate, title="Seed Reload Candidate", style=shape.labelup, location=location.belowbar, color=color.aqua, textcolor=color.black, size=size.tiny, text="25-50 RELOAD?")

// -------------------------- Acceptance duration ------------------------------
float normNow = f_norm(close)
var int t68 = na
var int t80 = na
var int t100 = na
var int t120 = na
var int t132 = na

f_update_start(int startT, bool condition) =>
    condition ? (na(startT) ? time : startT) : na

t68 := f_update_start(t68, not na(normNow) and normNow >= 68)
t80 := f_update_start(t80, not na(normNow) and normNow >= 80)
t100 := f_update_start(t100, not na(normNow) and normNow >= 100)
t120 := f_update_start(t120, not na(normNow) and normNow >= 120)
t132 := f_update_start(t132, not na(normNow) and normNow >= 132)

f_hours(int t0) => na(t0) ? 0.0 : (time - t0) / 3600000.0
float h68 = f_hours(t68)
float h80 = f_hours(t80)
float h100 = f_hours(t100)
float h120 = f_hours(t120)
float h132 = f_hours(t132)

// ----------------------------- Branch logic ---------------------------------
int stateNow = f_state_bin(normNow)
string phase = monthPos == 1 ? "M1 — RANGE SEED" : monthPos == 2 ? "M2 — SHAPING" : "M3 — RESOLUTION"
string branch = "WAIT"
string delivery = "—"
if m1Locked
    if monthPos == 2
        branch := normNow < 0 ? "M2 EXPANSION / M3 STILL LIVE" : normNow < 50 ? "NORMAL SHAPING" : "DEFER / M3 RESOLUTION BIAS"
        delivery := normNow < 0 ? "M1 -25 WATCH" : normNow >= 68 ? "M1 100 WATCH" : "M1 EDGE / 50 ZONE"
    else if monthPos == 3
        branch := normNow < 0 ? "M3 CONTINUATION" : normNow >= 68 ? "M3 REPAIR" : normNow >= 50 ? "FAILURE DEVELOPING" : "M3 UNRESOLVED"
        delivery := normNow < 0 ? "M1 -25 FIRST" : normNow >= 68 ? "M1 100 FIRST" : normNow >= 50 ? "M1 100 WATCH" : "M1 EDGE"

// -------------------------- Layer 3 setup engine ----------------------------
// These are the newer evidence-backed higher-order states. They remain separate
// from L2; no composite confluence score is created.
string l3Setup = "L3 WAIT"
string l3SetupTarget = "—"
bool seedCompressedFlag = d3Locked and not na(seedRange) and f_pips(seedRange) <= legacyMacroT1

if monthPos == 1 and d3Locked
    if seedReloadCandidate or (seedReloadTagged and not seedBreakConfirmed)
        l3Setup := "L3 M1 SEED RELOAD"
        l3SetupTarget := "SEED EDGE / +0.25"
    else if seedBreakConfirmed
        l3Setup := seedCompressedFlag ? "L3 M1 COMPRESSED SEED CONT*" : "L3 M1 SEED CONTINUATION"
        l3SetupTarget := "+0.25 / +0.50 SEED"
    else
        l3Setup := "L3 M1 SEED BUILD / WAIT"
        l3SetupTarget := "DIRECTIONAL EDGE"
else if monthPos == 2 and m1Locked
    if normNow < 0
        l3Setup := "L3 M2 CONTINUATION"
        l3SetupTarget := "M1 -25"
    else if m2Day <= 10 and normNow >= 25 and normNow < 50
        l3Setup := "L3 M2 NORMAL RELOAD"
        l3SetupTarget := "M1 EDGE / -25"
    else if normNow >= 50
        l3Setup := "L3 M2 DEFERRED RESOLUTION"
        l3SetupTarget := normNow >= 68 ? "M1 100" : "M3 INHERITS"
    else
        l3Setup := "L3 M2 SHAPING"
        l3SetupTarget := "M1 EDGE / 50"
else if monthPos == 3 and m1Locked
    if normNow < 0
        l3Setup := "L3 M3 RESOLUTION CONT"
        l3SetupTarget := "M1 -25"
    else if normNow >= 132 and h132 >= 8
        l3Setup := "L3 132->168 DEEP REKEY"
        l3SetupTarget := "M1 168"
    else if normNow >= 120 and h120 >= 8
        l3Setup := "L3 120->132 PROMOTION"
        l3SetupTarget := "M1 132"
    else if normNow >= 100 and normNow < 110
        l3Setup := "L3 MONTHLY SNAP AOI"
        l3SetupTarget := "RECOVERY 100->80->68"
    else if normNow >= 68
        l3Setup := "L3 M3 REPAIR"
        l3SetupTarget := "M1 100"
    else if normNow >= 50
        l3Setup := "L3 M3 FAILURE DEVELOPING"
        l3SetupTarget := "M1 100 WATCH"
    else
        l3Setup := "L3 M3 UNRESOLVED"
        l3SetupTarget := "WAIT FOR D3-D5"


// ---------------------------- Rolling metrics --------------------------------
f_sum_valid(int[] a) =>
    int s = 0
    int n = 0
    int sz = array.size(a)
    if sz > 0
        for i = 0 to sz - 1
            int v = array.get(a, i)
            if v >= 0
                s += v
                n += 1
    [s, n]

[d3WinsRoll, d3NRoll] = f_sum_valid(rollD3Correct)
[alignWinsRoll, alignNRoll] = f_sum_valid(rollAlignCorrect)
[m2WinsRoll, m2NRoll] = f_sum_valid(rollM2Break)

f_roll_cell(int cp, int b) =>
    int w = 0
    int n = 0
    int sz = math.min(array.size(rollM3Owner), cp == 3 ? array.size(rollD3Bin) : array.size(rollD5Bin))
    if cp > 0 and b >= 0 and sz > 0
        for i = 0 to sz - 1
            int cb = cp == 3 ? array.get(rollD3Bin, i) : array.get(rollD5Bin, i)
            if cb == b
                n += 1
                w += array.get(rollM3Owner, i)
    [w, n]

float rollQ50 = f_percentile_nearest(rollM1Mult, 50)
float rollQ75 = f_percentile_nearest(rollM1Mult, 75)
float rollQ90 = f_percentile_nearest(rollM1Mult, 90)

// Active validation checkpoint: latest locked D5 else D3.
int activeCp = monthPos == 3 and m3D5Bin >= 0 ? 5 : monthPos == 3 and m3D3Bin >= 0 ? 3 : 0
int activeBin = activeCp == 5 ? m3D5Bin : activeCp == 3 ? m3D3Bin : -1
[oosCellWins, oosCellN] = f_oos_cell(activeCp, activeBin)
[rollCellWins, rollCellN] = f_roll_cell(activeCp, activeBin)

// ------------------------- Setup transition labels -------------------------
var string prevL2Setup = ""
var string prevL3Setup = ""
bool l2SetupChanged = l2Setup != prevL2Setup
bool l3SetupChanged = l3Setup != prevL3Setup
if showL2Labels and l2SetupChanged and l2Checkpoint > 0 and l2Setup != "L2 WAIT" and l2Setup != "L2 NEUTRAL / WAIT"
    color l2c = str.contains(l2Setup,"LONG") or str.contains(l2Setup,"UPPER") ? color.new(color.lime,15) : str.contains(l2Setup,"SHORT") or str.contains(l2Setup,"LOWER") ? color.new(color.red,15) : color.new(#d4af37,15)
    label.new(bar_index, high, l2Setup + "\n" + l2Pace + " | " + l2LocState + " | Q50 left " + f_num(l2RemainQ50) + "p", style=label.style_label_down, color=l2c, textcolor=color.black, size=size.tiny)
if showSeedLabels and l3SetupChanged and l3Setup != "L3 WAIT"
    label.new(bar_index, low, l3Setup + "\nTARGET: " + l3SetupTarget, style=label.style_label_up, color=color.new(#d4af37,10), textcolor=color.black, size=size.tiny)
prevL2Setup := l2Setup
prevL3Setup := l3Setup

// ------------------------------ Dashboard -----------------------------------
var table main = table.new(f_table_pos(mainPosInput), 2, 27, border_width=1, frame_color=color.new(#d4af37, 10), border_color=color.new(color.gray, 70))
var table val = table.new(f_table_pos(valPosInput), 3, 12, border_width=1, frame_color=color.new(#d4af37, 10), border_color=color.new(color.gray, 70))

f_cell(table t, int c, int r, string text_, color fg, color bg) =>
    table.cell(t, c, r, text_, text_color=fg, bgcolor=bg, text_size=size.tiny)

if barstate.islast and showMainTable
    color hdr = color.new(#111111, 0)
    color bg = color.new(#060606, 8)
    color gold = #d4af37
    color white = #eaeaea
    color cyan = #00d9ff
    color warn = color.orange
    color red = color.red
    color green = color.lime

    string qTxt = str.tostring(yy) + " Q" + str.tostring(qNum)
    string d3Txt = d3Dir == 1 ? "UP" : d3Dir == -1 ? "DOWN" : "BUILDING"
    string m1Txt = m1Dir == 1 ? "UP" : m1Dir == -1 ? "DOWN" : "BUILDING"
    string alignTxt = d3Dir != 0 and m1Dir != 0 ? (d3Dir == m1Dir ? "ALIGNED" : "DIVERGED") : "WAIT"
    string dayTxt = monthPos == 2 ? "M2 D" + str.tostring(m2Day) : monthPos == 3 ? "M3 D" + str.tostring(m3Day) : "M1"
    string histProj = m1Locked ? f_num(f_pips(m1Range) * HIST_Q50) + " / " + f_num(f_pips(m1Range) * HIST_Q75) + " / " + f_num(f_pips(m1Range) * HIST_Q90) + "p" : "—"
    string rollProj = m1Locked and not na(rollQ50) ? f_num(f_pips(m1Range) * rollQ50) + " / " + f_num(f_pips(m1Range) * rollQ75) + " / " + f_num(f_pips(m1Range) * rollQ90) + "p" : "—"

    f_cell(main,0,0,"CEREBUS EUR HIGHER ORDER",gold,hdr), f_cell(main,1,0,"QUARTER / MONTH V1.2",white,hdr)
    f_cell(main,0,1,"Quarter / Phase",white,bg), f_cell(main,1,1,qTxt + " | " + phase,cyan,bg)
    f_cell(main,0,2,"First 3 Days",white,bg), f_cell(main,1,2,d3Txt,d3Dir==1?green:d3Dir==-1?red:warn,bg)
    f_cell(main,0,3,"Month 1 / Agreement",white,bg), f_cell(main,1,3,m1Txt + " | " + alignTxt,alignTxt=="ALIGNED"?green:alignTxt=="DIVERGED"?warn:white,bg)
    f_cell(main,0,4,"M1 Range",white,bg), f_cell(main,1,4,m1Locked?f_num(f_pips(m1Range))+"p":"BUILDING",gold,bg)
    f_cell(main,0,5,"Hist Q50/75/90",white,bg), f_cell(main,1,5,histProj,gold,bg)
    f_cell(main,0,6,"Rolling Q50/75/90",white,bg), f_cell(main,1,6,rollProj,cyan,bg)
    f_cell(main,0,7,"Checkpoint",white,bg), f_cell(main,1,7,dayTxt,white,bg)
    f_cell(main,0,8,"M1-relative State",white,bg), f_cell(main,1,8,na(normNow)?"—":f_num(normNow)+"% | "+f_state_name(stateNow),stateNow<=2?green:stateNow>=4?red:warn,bg)
    f_cell(main,0,9,"Branch",white,bg), f_cell(main,1,9,branch,branch=="M3 CONTINUATION"?green:branch=="M3 REPAIR"?red:warn,bg)
    f_cell(main,0,10,"First Delivery",white,bg), f_cell(main,1,10,delivery,gold,bg)
    f_cell(main,0,11,"Acceptance 68 / 80",white,bg), f_cell(main,1,11,f_num(h68)+"h / "+f_num(h80)+"h",white,bg)
    f_cell(main,0,12,"Acceptance 100 / 120",white,bg), f_cell(main,1,12,f_num(h100)+"h / "+f_num(h120)+"h",white,bg)
    f_cell(main,0,13,"Acceptance 132",white,bg), f_cell(main,1,13,f_num(h132)+"h",white,bg)
    f_cell(main,0,14,"M2 broke M1?",white,bg), f_cell(main,1,14,m2BreakM1?"YES":"NO",m2BreakM1?green:white,bg)
    f_cell(main,0,15,"M3 D3 / D5 Cell",white,bg), f_cell(main,1,15,(m3D3Bin>=0?f_state_name(m3D3Bin):"—")+" / "+(m3D5Bin>=0?f_state_name(m3D5Bin):"—"),white,bg)
    string seedDirTxt = d3Dir == 1 ? "UP" : d3Dir == -1 ? "DOWN" : "BUILDING"
    string seedBreakTxt = seedBreakFirst == 1 ? "DIR FIRST" : seedBreakFirst == -1 ? "OPP FIRST" : "WAIT"
    string seedMapTxt = d3Locked and not na(seedRange) ? f_num(f_pips(seedRange)) + "p | " + seedDirTxt : "BUILDING"
    string seedTargetsTxt = d3Locked ? "+0.25 82.5% | +0.50 67.5% | +1.00 55.0%" : "—"

    f_cell(main,0,16,"M1 D1-D3 Seed",white,bg), f_cell(main,1,16,seedMapTxt,gold,bg)
    f_cell(main,0,17,"Seed First Break",white,bg), f_cell(main,1,17,seedBreakTxt + " | 67.8% DIR-FIRST HIST",seedBreakFirst==1?green:seedBreakFirst==-1?red:warn,bg)
    f_cell(main,0,18,"Seed Median Run",white,bg), f_cell(main,1,18,"1.12x if DIR-FIRST | mean 1.34x",cyan,bg)
    f_cell(main,0,19,"Seed Target Ref",white,bg), f_cell(main,1,19,seedTargetsTxt,cyan,bg)
    f_cell(main,0,20,"L2 Weekly Setup",white,bg), f_cell(main,1,20,l2Setup,l2Exhaustion?red:(str.contains(l2Setup,"CONT") or str.contains(l2Setup,"RELOAD"))?green:warn,bg)
    f_cell(main,0,21,"L2 State",white,bg), f_cell(main,1,21,l2TierTxt+" | H"+str.tostring(l2WeekHour)+" | "+l2LocState+" | "+l2Pace,cyan,bg)
    f_cell(main,0,22,"L2 Range Left / P(new)",white,bg), f_cell(main,1,22,f_num(l2RemainQ50)+"p | "+f_pct(l2PAny),cyan,bg)
    f_cell(main,0,23,"L3 Setup",white,bg), f_cell(main,1,23,l3Setup,gold,bg)
    f_cell(main,0,24,"L3 Target",white,bg), f_cell(main,1,24,l3SetupTarget,cyan,bg)
    string legacyFlagTxt = seedCompressedFlag ? "COMPRESSED SEED*: QDIR 81.3% N16" : "PARKED UNLESS FLAGGED"
    f_cell(main,0,25,"Legacy Research",white,bg), f_cell(main,1,25,showLegacyFlags?legacyFlagTxt:"HIDDEN",seedCompressedFlag?green:warn,bg)
    f_cell(main,0,26,"Doctrine",white,bg), f_cell(main,1,26,"L3=DESTINATION | L2=PATH | L1=ENTRY | NO FORCED SCORE",gold,bg)

if barstate.islast and showValidation
    color hdr = color.new(#111111,0)
    color bg = color.new(#060606,8)
    color gold = #d4af37
    color white = #eaeaea
    color cyan = #00d9ff
    color warn = color.orange

    f_cell(val,0,0,"VALIDATION",gold,hdr), f_cell(val,1,0,"OOS BENCH",white,hdr), f_cell(val,2,0,"ROLLING",cyan,hdr)
    f_cell(val,0,1,"D3 -> Q Dir",white,bg), f_cell(val,1,1,"71.4% (10/14)",white,bg), f_cell(val,2,1,f_rate_text(d3WinsRoll,d3NRoll),cyan,bg)
    f_cell(val,0,2,"D3+M1 Align",white,bg), f_cell(val,1,2,"100% (6/6)*",warn,bg), f_cell(val,2,2,f_rate_text(alignWinsRoll,alignNRoll),cyan,bg)
    f_cell(val,0,3,"M2 Breaks M1",white,bg), f_cell(val,1,3,"71.4% (10/14)",white,bg), f_cell(val,2,3,f_rate_text(m2WinsRoll,m2NRoll),cyan,bg)
    string cpName = activeCp == 3 ? "M3 D3 " + f_state_name(activeBin) : activeCp == 5 ? "M3 D5 " + f_state_name(activeBin) : "M3 CELL"
    f_cell(val,0,4,cpName,white,bg), f_cell(val,1,4,f_rate_text(oosCellWins,oosCellN),oosCellN>0?white:warn,bg), f_cell(val,2,4,f_rate_text(rollCellWins,rollCellN),cyan,bg)
    f_cell(val,0,5,"Range Mult Q50",white,bg), f_cell(val,1,5,"1.64x HIST",white,bg), f_cell(val,2,5,na(rollQ50)?"—":f_num(rollQ50)+"x",cyan,bg)
    f_cell(val,0,6,"M1 D1-D3 -> Q",white,bg), f_cell(val,1,6,"69.5% FROZEN",white,bg), f_cell(val,2,6,"SEED PRIOR",cyan,bg)
    f_cell(val,0,7,"DIR-FIRST +0.50",white,bg), f_cell(val,1,7,"67.5% (N=40)",white,bg), f_cell(val,2,7,"1.12x MED RUN",cyan,bg)
    f_cell(val,0,8,"Legacy W Coil*",white,bg), f_cell(val,1,8,"+0.50 7/7 | N=7",warn,bg), f_cell(val,2,8,"FLAG ONLY",warn,bg)
    f_cell(val,0,9,"Legacy Exhaust Snap",white,bg), f_cell(val,1,9,"MID 1/18",red,bg), f_cell(val,2,9,"PARKED",red,bg)
    f_cell(val,0,10,"Compressed Seed*",white,bg), f_cell(val,1,10,"Q DIR 81.3% | N=16",warn,bg), f_cell(val,2,10,"RESEARCH FLAG",warn,bg)
    f_cell(val,0,11,"Small-N Rule",white,bg), f_cell(val,1,11,"SHOW N",warn,bg), f_cell(val,2,11,"DO NOT HARD-CODE",warn,bg)

// ------------------------------- Alerts -------------------------------------
bool m3Cont = monthPos == 3 and not na(normNow) and normNow < 0
bool m3Repair = monthPos == 3 and not na(normNow) and normNow >= 68
bool rekeyPromote = not na(normNow) and normNow >= 120 and h120 >= 8
bool deepConfirm = not na(normNow) and normNow >= 132 and h132 >= 8

alertcondition(d3Locked and not d3Locked[1], "EUR Quarter D3 Locked", "CEREBUS EUR Higher Order: first 3 trading-day direction locked.")
alertcondition(m1Locked and not m1Locked[1], "EUR Month 1 Locked", "CEREBUS EUR Higher Order: Month 1 range locked.")
alertcondition(m3Cont and not m3Cont[1], "EUR M3 Continuation State", "CEREBUS EUR Higher Order: M3 accepted beyond M1 directional edge.")
alertcondition(m3Repair and not m3Repair[1], "EUR M3 Repair State", "CEREBUS EUR Higher Order: M3 at 68%+ M1 rekey depth.")
alertcondition(rekeyPromote and not rekeyPromote[1], "EUR Monthly 120 Promotion", "CEREBUS EUR Higher Order: 120% monthly rekey accepted for 8h+.")
alertcondition(deepConfirm and not deepConfirm[1], "EUR Monthly 132 Confirmation", "CEREBUS EUR Higher Order: 132% monthly rekey accepted for 8h+.")

alertcondition(seedBreakConfirmed and not seedBreakConfirmed[1], "EUR M1 D1-D3 Seed Break", "CEREBUS EUR V1.2: M1 D1-D3 directional seed break confirmed.")
alertcondition(seedReloadCandidate, "EUR M1 D1-D3 25-50 Reload Candidate", "CEREBUS EUR V1.2: price revisited the M1 D1-D3 25-50% reload zone and recovered the 25% node. Research candidate only.")


alertcondition(l2SetupChanged and str.contains(l2Setup,"CONT"), "EUR L2 Continuation Setup", "CEREBUS EUR V1.2: modern weekly continuation setup active.")
alertcondition(l2SetupChanged and str.contains(l2Setup,"PRIME RELOAD"), "EUR L2 Prime Reload", "CEREBUS EUR V1.2: weekly prime-window reload setup active.")
alertcondition(l2SetupChanged and l2Exhaustion, "EUR L2 Exhaustion", "CEREBUS EUR V1.2: weekly middle-third + ahead/excess pace exhaustion/no-edge state.")
alertcondition(l3SetupChanged and str.contains(l3Setup,"M2 NORMAL RELOAD"), "EUR L3 M2 Normal Reload", "CEREBUS EUR V1.2: M2 early 25-50% normal reload state.")
alertcondition(l3SetupChanged and str.contains(l3Setup,"M3 RESOLUTION CONT"), "EUR L3 M3 Resolution Continuation", "CEREBUS EUR V1.2: M3 continuation beyond M1 directional edge.")
alertcondition(l3SetupChanged and str.contains(l3Setup,"M3 REPAIR"), "EUR L3 M3 Repair", "CEREBUS EUR V1.2: M3 68%+ repair state; M1 100 boundary promoted.")