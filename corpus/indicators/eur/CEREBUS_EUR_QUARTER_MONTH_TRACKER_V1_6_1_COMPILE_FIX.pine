//@version=6
indicator("CEREBUS EUR Quarter / Month Tracker V1.6.1", overlay=true, max_lines_count=500, max_labels_count=300, max_boxes_count=200)

// ============================================================================
// CEREBUS EUR QUARTER / MONTH TRACKER V1.6.1
// Higher-order quarter/month distribution engine + M1 seed + modern L2/L3 setup states.
// Purpose: destination + regime tracking. Not a full Game matrix.
// Weekly and Daily engines remain independent by design.
// Time basis: America/New_York.
// ============================================================================

// ------------------------------- Inputs -------------------------------------
string TZ = input.string("America/New_York", "Timezone", group="System")

// --- Core higher-order plots ---
bool showLevels = input.bool(true, "Show M1 Fib / Rekey Levels", group="Plots — Core")
bool showExtensions = input.bool(true, "Show M1 Directional Extensions", group="Plots — Core")

// --- M1 D1-D3 seed plots ---
bool showSeedMap = input.bool(true, "Show M1 D1-D3 Seed Map", group="Plots — M1 Seed")
bool showSeedExtensions = input.bool(true, "Show Seed Continuation Targets", group="Plots — M1 Seed")
bool showSeedReloadZone = input.bool(true, "Shade 25-50% Seed Reload Zone", group="Plots — M1 Seed")
bool showSeedDeepMap = input.bool(false, "Show Deep 68-168% Seed Rekey Map", group="Plots — M1 Seed")
bool showSeedLabels = input.bool(true, "Show Seed Setup Labels", group="Plots — M1 Seed")
string seedConfirmTF = input.string("H1 close", "Seed break confirmation", options=["Touch", "Chart close", "H1 close"], group="Plots — M1 Seed")

// --- Layer 2 weekly setup engine ---
bool showL2Setup = input.bool(true, "Enable L2 Weekly Setup Engine", group="Layer 2 — Engine")
bool showL2Levels = input.bool(false, "Show Weekly Thirds", group="Layer 2 — Plots")
bool showL2EntryPlots = input.bool(true, "Show Active L2 Entry Boundary / Zone", group="Layer 2 — Plots")
bool showL2TargetPlots = input.bool(true, "Show Active L2 Target", group="Layer 2 — Plots")
bool showL2InvalidPlots = input.bool(false, "Show L2 Invalidation Boundary", group="Layer 2 — Plots")
bool showL2Labels = input.bool(true, "Show L2 Setup Labels", group="Layer 2 — Plots")
float l2T1Max = input.float(20.0, "L2 T1 Monday Asian Max (pips)", step=0.1, group="Layer 2 — Engine")
float l2T2Max = input.float(30.0, "L2 T2 Monday Asian Max (pips)", step=0.1, group="Layer 2 — Engine")
float l2T3Max = input.float(45.0, "L2 T3 / No-Go Max (pips)", step=0.1, group="Layer 2 — Engine")

// --- Layer 3 setup plots ---
bool showL3EntryPlots = input.bool(true, "Show Active L3 Entry Levels / Zones", group="Layer 3 — Plots")
bool showL3TargetPlots = input.bool(true, "Show Active L3 Targets", group="Layer 3 — Plots")
bool showL3InvalidPlots = input.bool(false, "Show L3 Research Invalidation Reference", group="Layer 3 — Plots")
bool showL3Labels = input.bool(true, "Show L3 Setup Labels", group="Layer 3 — Plots")

// --- Research flags ---
bool showLegacyFlags = input.bool(false, "Show Legacy Research Flags", group="Research Flags")
float legacyMacroT1 = input.float(108.1, "Legacy Macro T1 D1-D3 max (pips)", step=0.1, group="Research Flags")

// --- Fully independent panels ---
bool showCorePanel = input.bool(true, "Show Core / Quarter Panel", group="Panels — Core")
