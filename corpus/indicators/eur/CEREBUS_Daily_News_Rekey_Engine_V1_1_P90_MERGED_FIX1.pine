f_tablePos(string x, string y) =>
    x == "Left" ? (y == "Top" ? position.top_left : y == "Middle" ? position.middle_left : position.bottom_left) :
     x == "Center" ? (y == "Top" ? position.top_center : y == "Middle" ? position.middle_center : position.bottom_center) :
     (y == "Top" ? position.top_right : y == "Middle" ? position.middle_right : position.bottom_right)

f_textSize(string s) =>
    s == "Tiny" ? size.tiny : s == "Small" ? size.small : s == "Large" ? size.large : size.normal

