//@version=6
// =============================================================================
// CEREBUS Symmetry Trap v5 — Atomic Engine (EUR/USD)
// Marks every atomic impulse (10p+), shows density zone + entry per impulse
// Multiple setups per day — no Asian H/L breakout requirement
// =============================================================================
indicator("CEREBUS Symmetry Trap v5", overlay=true,
     max_lines_count=500, max_boxes_count=200, max_labels_count=500)

i_tz          = input.string("America/New_York", "Timezone", options=["America/New_York","UTC","Europe/London"])
i_hard_exit_h = input.int(12, "Hard Exit Hour (EST)", minval=10, maxval=17)
i_show_grid   = input.bool(true, "Show Atomic Grid")
i_show_zones  = input.bool(true, "Show Density Zones")
i_show_imp    = input.bool(true, "Show Impulse Markers")
i_show_entry  = input.bool(true, "Show Entry Signals")
i_show_panel  = input.bool(true, "Show Truth Panel")

pip = 0.0001

// Asian range + tier (visual reference + parameter selection)
asian_sess    = "1900-0300"
in_asian      = timeframe.isintraday and not na(time(timeframe.period, asian_sess, i_tz))
asian_started = in_asian and not in_asian[1]
asian_ended   = not in_asian and in_asian[1]

var float ar_hi   = na
var float ar_lo   = na
var float ar_pips = na
var int   tier    = 1

if asian_started
    ar_hi := high
    ar_lo := low

if in_asian and not asian_started
    ar_hi := math.max(ar_hi, high)
    ar_lo := math.min(ar_lo, low)

if asian_ended
    ar_pips := (ar_hi - ar_lo) / pip
    tier    := ar_pips <= 20 ? 1 : ar_pips <= 30 ? 2 : ar_pips <= 45 ? 3 : 0

// EUR tier parameters
// T1 (<20p): atom=10p  dz=8-12p  aleg=10p
// T2 (20-30p): atom=12p  dz=10-14p  aleg=14p
// T3 (30-45p): atom=15p  dz=13-17p  aleg=18p
atomic_pips = tier == 1 ? 10.0 : tier == 2 ? 12.0 : tier == 3 ? 15.0 : 10.0
dz_min_pips = tier == 1 ?  8.0 : tier == 2 ? 10.0 : tier == 3 ? 13.0 :  8.0
dz_max_pips = tier == 1 ? 12.0 : tier == 2 ? 14.0 : tier == 3 ? 17.0 : 12.0
aleg_pips   = tier == 1 ? 10.0 : tier == 2 ? 14.0 : tier == 3 ? 18.0 : 10.0

atomic = atomic_pips * pip
dz_min = dz_min_pips * pip
dz_max = dz_max_pips * pip
aleg   = aleg_pips   * pip

cb       = math.abs(close - open)
min_body = 4.5 * pip

// Atomic impulse: any candle with body >= atomic unit
impulse_bull = cb >= atomic and close > open and barstate.isconfirmed
impulse_bear = cb >= atomic and close < open and barstate.isconfirmed

// Impulse state (resets on every new impulse — fresh DZ each time)
var int   imp_dir    = 0
var float imp_peak   = na
var int   imp_bar    = na
var bool  imp_active = false

if impulse_bull
    imp_dir    := 1
    imp_peak   := high
    imp_bar    := bar_index
    imp_active := true

if impulse_bear
    imp_dir    := -1
    imp_peak   := low
    imp_bar    := bar_index
    imp_active := true

if imp_active and imp_dir == 1
    imp_peak := math.max(imp_peak, high)
if imp_active and imp_dir == -1
    imp_peak := math.min(imp_peak, low)

// Density zone: pullback depth from impulse peak
pb    = imp_active and not na(imp_peak) ? (imp_dir == 1 ? (imp_peak - low) / pip : imp_dir == -1 ? (high - imp_peak) / pip : 0.0) : 0.0
in_dz = imp_active and pb >= dz_min_pips and pb <= dz_max_pips

// Entry: opposite candle (body >= 4.5p) closes in density zone
// Long: bull impulse -> pullback -> bullish candle in DZ -> ENTER
// Short: bear impulse -> pullback -> bearish candle in DZ -> ENTER
var bool  in_trade  = false
var int   trade_dir = 0
var float entry_px  = na
var float aleg_px   = na
var int   entry_bar = na

// New impulse cancels active trade (fresh setup)
if impulse_bull or impulse_bear
    in_trade  := false
    trade_dir := 0

long_entry  = imp_active and imp_dir == 1  and in_dz and close > open and cb >= min_body and not in_trade and barstate.isconfirmed
short_entry = imp_active and imp_dir == -1 and in_dz and close < open and cb >= min_body and not in_trade and barstate.isconfirmed

if long_entry
    in_trade  := true
    trade_dir := 1
    entry_px  := close
    aleg_px   := close + aleg
    entry_bar := bar_index

if short_entry
    in_trade  := true
    trade_dir := -1
    entry_px  := close
    aleg_px   := close - aleg
    entry_bar := bar_index

a_hit_l = in_trade and trade_dir == 1  and high >= aleg_px
a_hit_s = in_trade and trade_dir == -1 and low  <= aleg_px

bse     = na(entry_bar) ? 0 : bar_index - entry_bar
ews_win = bse >= 6 and bse <= 12
ews_l   = in_trade and trade_dir == 1  and ews_win and close < open and cb >= min_body
ews_s   = in_trade and trade_dir == -1 and ews_win and close > open and cb >= min_body

in_hard = hour(time, i_tz) >= i_hard_exit_h
hard_x  = in_trade and in_hard and barstate.isconfirmed

if a_hit_l or a_hit_s or ews_l or ews_s or hard_x
    in_trade  := false
    trade_dir := 0

// Panel strings
bias_str  = imp_dir == 1 ? "BUY" : imp_dir == -1 ? "SELL" : "FLAT"
bias_col  = imp_dir == 1 ? color.lime : imp_dir == -1 ? color.red : color.gray
tier_str  = tier == 0 ? "N/A" : "T" + str.tostring(tier)
tier_col  = tier == 1 ? color.lime : tier == 2 ? color.yellow : tier == 3 ? color.orange : color.gray
range_str = na(ar_pips) ? "--" : str.tostring(math.round(ar_pips)) + "p"
atom_str  = str.tostring(atomic_pips, "#") + "p"
aleg_str2 = str.tostring(aleg_pips, "#") + "p"
_dt       = str.format("{0,date,yyyyMMdd}", time)
_hm       = str.format("{0,date,HHmm}", time)
state_id  = "EURUSD_" + _dt + "_" + _hm + "_" + bias_str + "_v5"
valid_str = str.format("{0,date,HH:mm}", time_close)

// VISUALS
plotshape(i_show_imp and impulse_bull, "Bull Impulse", location=location.belowbar, style=shape.diamond, color=color.new(color.aqua,0), size=size.small)
plotshape(i_show_imp and impulse_bear, "Bear Impulse", location=location.abovebar, style=shape.diamond, color=color.new(color.fuchsia,0), size=size.small)

if i_show_imp and impulse_bull
    label.new(bar_index, low, text=str.tostring(math.round(cb/pip)) + "p  DZ:" + str.tostring(dz_min_pips,"#") + "-" + str.tostring(dz_max_pips,"#") + "p", style=label.style_label_up, color=color.new(color.aqua,20), textcolor=color.white, size=size.small)
if i_show_imp and impulse_bear
    label.new(bar_index, high, text=str.tostring(math.round(cb/pip)) + "p  DZ:" + str.tostring(dz_min_pips,"#") + "-" + str.tostring(dz_max_pips,"#") + "p", style=label.style_label_down, color=color.new(color.fuchsia,20), textcolor=color.white, size=size.small)

bgcolor(in_dz and imp_dir == 1  ? color.new(color.lime,85) : na, title="DZ Long")
bgcolor(in_dz and imp_dir == -1 ? color.new(color.red,85)  : na, title="DZ Short")

plotshape(i_show_entry and long_entry,  "Long Entry",  location=location.belowbar, style=shape.triangleup,   color=color.new(color.lime,0), size=size.large)
plotshape(i_show_entry and short_entry, "Short Entry", location=location.abovebar, style=shape.triangledown, color=color.new(color.red,0),  size=size.large)
plotshape(i_show_entry and (ews_l or ews_s), "EWS Exit", location=location.belowbar, style=shape.xcross, color=color.new(color.orange,0), size=size.normal)
plotshape(i_show_entry and (a_hit_l or a_hit_s), "A-Leg Hit", location=location.abovebar, style=shape.flag, color=color.new(color.yellow,0), size=size.small)

if long_entry
    label.new(bar_index, low, text="LONG " + str.tostring(aleg_pips,"#") + "p", style=label.style_label_up, color=color.new(color.lime,10), textcolor=color.black, size=size.normal)
if short_entry
    label.new(bar_index, high, text="SHORT " + str.tostring(aleg_pips,"#") + "p", style=label.style_label_down, color=color.new(color.red,10), textcolor=color.white, size=size.normal)

plot(not na(ar_hi) ? ar_hi : na, "Asian High", color=color.new(color.blue,30), linewidth=2, style=plot.style_linebr)
plot(not na(ar_lo) ? ar_lo : na, "Asian Low",  color=color.new(color.blue,30), linewidth=2, style=plot.style_linebr)
plot(not na(ar_hi) and not na(ar_lo) ? (ar_hi+ar_lo)*0.5 : na, "Asian Mid", color=color.new(color.blue,60), linewidth=1, style=plot.style_linebr)

if i_show_grid and not na(ar_hi) and not na(atomic) and barstate.islast
    for i = 1 to 8
        line.new(bar_index-300, ar_hi+i*atomic, bar_index+60, ar_hi+i*atomic, color=color.new(color.teal,35), style=line.style_dashed, width=1)
        line.new(bar_index-300, ar_lo-i*atomic, bar_index+60, ar_lo-i*atomic, color=color.new(color.teal,35), style=line.style_dashed, width=1)

var box dz_box = na

if i_show_zones and impulse_bull
    if not na(dz_box)
        box.delete(dz_box)
    dz_box := box.new(bar_index, high-dz_min, bar_index+80, high-dz_max, bgcolor=color.new(color.lime,70), border_color=color.new(color.lime,0), border_width=2, border_style=line.style_solid)

if i_show_zones and impulse_bear
    if not na(dz_box)
        box.delete(dz_box)
    dz_box := box.new(bar_index, low+dz_max, bar_index+80, low+dz_min, bgcolor=color.new(color.red,70), border_color=color.new(color.red,0), border_width=2, border_style=line.style_solid)

if i_show_zones and imp_active and not na(dz_box) and barstate.islast
    if imp_dir == 1
        box.set_top(dz_box, imp_peak-dz_min)
        box.set_bottom(dz_box, imp_peak-dz_max)
        box.set_right(dz_box, bar_index+30)
    if imp_dir == -1
        box.set_top(dz_box, imp_peak+dz_max)
        box.set_bottom(dz_box, imp_peak+dz_min)
        box.set_right(dz_box, bar_index+30)

var line aleg_line = na
if in_trade and not na(entry_bar) and barstate.islast
    if not na(aleg_line)
        line.delete(aleg_line)
    aleg_line := line.new(entry_bar, aleg_px, bar_index+30, aleg_px, color=color.new(color.yellow,0), style=line.style_dashed, width=2)

var table tp = table.new(position.top_right, 2, 8, bgcolor=color.new(color.black,8), border_width=1, border_color=color.new(color.gray,50), frame_width=1, frame_color=color.new(color.gray,30))

if i_show_panel and barstate.islast
    table.cell(tp,0,0,"CEREBUS v5",   text_color=color.white,  text_size=size.small,  bgcolor=color.new(color.navy,15), text_halign=text.align_center)
    table.cell(tp,1,0,"TRAP",         text_color=color.orange, text_size=size.small,  bgcolor=color.new(color.navy,15), text_halign=text.align_center)
    table.cell(tp,0,1,"SIDE",         text_color=color.white,  text_size=size.normal, text_halign=text.align_left)
    table.cell(tp,1,1,bias_str,       text_color=bias_col,     text_size=size.normal, text_halign=text.align_center)
    table.cell(tp,0,2,"TIER",         text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp,1,2,tier_str,       text_color=tier_col,     text_size=size.small,  text_halign=text.align_center)
    table.cell(tp,0,3,"RANGE",        text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp,1,3,range_str,      text_color=color.silver, text_size=size.small,  text_halign=text.align_center)
    table.cell(tp,0,4,"ATOM",         text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp,1,4,atom_str,       text_color=color.aqua,   text_size=size.small,  text_halign=text.align_center)
    table.cell(tp,0,5,"A-LEG",        text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp,1,5,aleg_str2,      text_color=color.aqua,   text_size=size.small,  text_halign=text.align_center)
    table.cell(tp,0,6,"STATE ID",     text_color=color.white,  text_size=size.tiny,   text_halign=text.align_left)
    table.cell(tp,1,6,state_id,       text_color=color.yellow, text_size=size.tiny,   text_halign=text.align_center)
    table.cell(tp,0,7,"VALID UNTIL",  text_color=color.white,  text_size=size.tiny,   text_halign=text.align_left)
    table.cell(tp,1,7,valid_str,      text_color=color.white,  text_size=size.tiny,   text_halign=text.align_center)

alertcondition(long_entry,         "CEREBUS Long Entry",  "CEREBUS LONG | {{ticker}} | {{timenow}} | {{close}}")
alertcondition(short_entry,        "CEREBUS Short Entry", "CEREBUS SELL | {{ticker}} | {{timenow}} | {{close}}")
alertcondition(ews_l or ews_s,     "CEREBUS EWS Exit",    "CEREBUS EWS | {{ticker}} | {{timenow}} | {{close}}")
alertcondition(a_hit_l or a_hit_s, "CEREBUS A-Leg Hit",   "CEREBUS ALEG | {{ticker}} | {{timenow}} | {{close}}")
