//@version=6
// =============================================================================
// CEREBUS Symmetry Trap v5 — Atomic Engine (EUR/USD)
// Spec: anchor = high[1]/low[1] of candle BEFORE signal
//       DZ measured FROM anchor (8-12p below for longs, above for shorts)
//       Chain: each swing starts from anchor of previous signal
// =============================================================================
indicator("CEREBUS Symmetry Trap v5", overlay=true,
     max_lines_count=500, max_boxes_count=200, max_labels_count=500)

i_tz         = input.string("America/New_York", "Timezone", options=["America/New_York","UTC","Europe/London"])
i_show_tier  = input.bool(true, "Show Tier Impulses")
i_show_atom  = input.bool(true, "Show Atomic Moves")
i_show_dz    = input.bool(true, "Show Density Zone")
i_show_entry = input.bool(true, "Show Entry Signals")
i_show_panel = input.bool(true, "Show Truth Panel")

// EUR T1 (hardcoded — add pairs via inputs later)
pip         = 0.0001
tier_pips   = 12.0
atomic_pips = 10.0
dz_lo_mult  = 0.80
dz_hi_mult  = 1.20
mb_pips     = 4.5
aleg_pips   = 10.0

tier_trig = tier_pips   * pip
atomic    = atomic_pips * pip
dz_min    = atomic * dz_lo_mult
dz_max    = atomic * dz_hi_mult
min_body  = mb_pips * pip
aleg      = aleg_pips * pip

cb       = math.abs(close - open)
opp_bull = close > open and cb >= min_body
opp_bear = close < open and cb >= min_body

// Asian range (visual reference + tier day classification)
asian_sess    = "1900-0300"
in_asian      = timeframe.isintraday and not na(time(timeframe.period, asian_sess, i_tz))
asian_started = in_asian and not in_asian[1]
asian_ended   = not in_asian and in_asian[1]

var float ar_hi   = na
var float ar_lo   = na
var float ar_pips = na
var int   tier    = 1

if asian_started
    ar_hi := high
    ar_lo := low
if in_asian and not asian_started
    ar_hi := math.max(ar_hi, high)
    ar_lo := math.min(ar_lo, low)
if asian_ended
    ar_pips := (ar_hi - ar_lo) / pip
    tier    := ar_pips <= 20 ? 1 : ar_pips <= 30 ? 2 : ar_pips <= 45 ? 3 : 0

// ── SWING TRACKER ─────────────────────────────────────────────────────────────
// Signal fires: swing moves >= threshold AND first opposite candle closes.
// Anchor = high[1] (bear signal) or low[1] (bull signal).
// New swing starts from anchor point.

var int   swing_dir  = 0
var float swing_strt = na
var int   swing_sbar = na
var float swing_ext  = na
var bool  tier_met   = false

if swing_dir == 1 and (na(swing_ext) or high > swing_ext)
    swing_ext := high
if swing_dir == -1 and (na(swing_ext) or low < swing_ext)
    swing_ext := low

if swing_dir == 1 and not na(swing_ext) and not na(swing_strt)
    if (swing_ext - swing_strt) >= tier_trig
        tier_met := true
if swing_dir == -1 and not na(swing_ext) and not na(swing_strt)
    if (swing_strt - swing_ext) >= tier_trig
        tier_met := true

atom_up   = swing_dir == 1  and not na(swing_ext) and not na(swing_strt) and (swing_ext - swing_strt) >= atomic
atom_down = swing_dir == -1 and not na(swing_ext) and not na(swing_strt) and (swing_strt - swing_ext) >= atomic

bear_signal = (tier_met or atom_up)   and opp_bear and barstate.isconfirmed and swing_dir == 1
bull_signal = (tier_met or atom_down) and opp_bull and barstate.isconfirmed and swing_dir == -1

if swing_dir == 0 and cb >= atomic and barstate.isconfirmed
    swing_dir  := close > open ? 1 : -1
    swing_strt := open
    swing_sbar := bar_index
    swing_ext  := close > open ? high : low
    tier_met   := cb >= tier_trig

// ── DENSITY ZONE STATE ────────────────────────────────────────────────────────
var float dz_anchor = na
var int   dz_dir    = 0
var box   dz_box    = na

dz_top = dz_dir == 1  ? dz_anchor - dz_min  : dz_dir == -1 ? dz_anchor + dz_max : na
dz_bot = dz_dir == 1  ? dz_anchor - dz_max  : dz_dir == -1 ? dz_anchor + dz_min : na

in_dz = dz_dir != 0 and not na(dz_top) and not na(dz_bot) and close <= dz_top and close >= dz_bot

// ── ENTRIES ───────────────────────────────────────────────────────────────────
long_entry  = in_dz and dz_dir == 1  and opp_bull and not bear_signal and barstate.isconfirmed
short_entry = in_dz and dz_dir == -1 and opp_bear and not bull_signal and barstate.isconfirmed

if long_entry
    dz_dir    := 0
    swing_dir  := 1
    swing_strt := close
    swing_sbar := bar_index
    swing_ext  := high
    tier_met   := false

if short_entry
    dz_dir    := 0
    swing_dir  := -1
    swing_strt := close
    swing_sbar := bar_index
    swing_ext  := low
    tier_met   := false

// ── BEAR SIGNAL (bull swing ended) ───────────────────────────────────────────
if bear_signal
    anchor   = high[1]
    sig_pips = not na(swing_ext) and not na(swing_strt) ? (swing_ext - swing_strt) / pip : 0.0
    is_tier  = sig_pips >= tier_pips

    line.new(swing_sbar, swing_strt, bar_index - 1, anchor,
         color = is_tier ? color.new(color.lime, 0) : color.new(color.aqua, 50),
         width = is_tier ? 2 : 1)

    if (is_tier and i_show_tier) or (not is_tier and i_show_atom)
        label.new(bar_index - 1, anchor,
             text  = (is_tier ? "TIER " : "ATOM ") + str.tostring(math.round(sig_pips)) + "p",
             style = label.style_label_down,
             color = is_tier ? color.new(color.lime, 20) : color.new(color.aqua, 50),
             textcolor = color.white, size = size.tiny)

    if is_tier and i_show_dz
        if not na(dz_box)
            box.delete(dz_box)
        dz_box    := box.new(bar_index - 1, anchor - dz_min, bar_index + 30, anchor - dz_max,
             bgcolor = color.new(color.lime, 75), border_color = color.new(color.lime, 0), border_width = 2)
        dz_anchor := anchor
        dz_dir    := 1

    swing_dir  := -1
    swing_strt := anchor
    swing_sbar := bar_index - 1
    swing_ext  := low
    tier_met   := false

// ── BULL SIGNAL (bear swing ended) ───────────────────────────────────────────
if bull_signal
    anchor   = low[1]
    sig_pips = not na(swing_strt) and not na(swing_ext) ? (swing_strt - swing_ext) / pip : 0.0
    is_tier  = sig_pips >= tier_pips

    line.new(swing_sbar, swing_strt, bar_index - 1, anchor,
         color = is_tier ? color.new(color.red, 0) : color.new(color.fuchsia, 50),
         width = is_tier ? 2 : 1)

    if (is_tier and i_show_tier) or (not is_tier and i_show_atom)
        label.new(bar_index - 1, anchor,
             text  = (is_tier ? "TIER " : "ATOM ") + str.tostring(math.round(sig_pips)) + "p",
             style = label.style_label_up,
             color = is_tier ? color.new(color.red, 20) : color.new(color.fuchsia, 50),
             textcolor = color.white, size = size.tiny)

    if is_tier and i_show_dz
        if not na(dz_box)
            box.delete(dz_box)
        dz_box    := box.new(bar_index - 1, anchor + dz_max, bar_index + 30, anchor + dz_min,
             bgcolor = color.new(color.red, 75), border_color = color.new(color.red, 0), border_width = 2)
        dz_anchor := anchor
        dz_dir    := -1

    swing_dir  := 1
    swing_strt := anchor
    swing_sbar := bar_index - 1
    swing_ext  := high
    tier_met   := false

// Extend DZ box right edge live
if not na(dz_box) and dz_dir != 0 and barstate.islast
    box.set_right(dz_box, bar_index + 30)

// ── VISUALS ───────────────────────────────────────────────────────────────────
plotshape(i_show_entry and long_entry,  "Long Entry",  location=location.belowbar, style=shape.triangleup,   color=color.new(color.lime, 0), size=size.large)
plotshape(i_show_entry and short_entry, "Short Entry", location=location.abovebar, style=shape.triangledown, color=color.new(color.red,  0), size=size.large)

if long_entry
    label.new(bar_index, low,  text="LONG "  + str.tostring(aleg_pips, "#") + "p", style=label.style_label_up,   color=color.new(color.lime, 10), textcolor=color.black, size=size.normal)
if short_entry
    label.new(bar_index, high, text="SHORT " + str.tostring(aleg_pips, "#") + "p", style=label.style_label_down, color=color.new(color.red,  10), textcolor=color.white, size=size.normal)

bgcolor(in_dz and dz_dir == 1  ? color.new(color.lime, 88) : na, title="Long DZ BG")
bgcolor(in_dz and dz_dir == -1 ? color.new(color.red,  88) : na, title="Short DZ BG")

plot(not na(ar_hi) ? ar_hi : na, "Asian High", color=color.new(color.blue, 30), linewidth=2, style=plot.style_linebr)
plot(not na(ar_lo) ? ar_lo : na, "Asian Low",  color=color.new(color.blue, 30), linewidth=2, style=plot.style_linebr)
plot(not na(ar_hi) and not na(ar_lo) ? (ar_hi + ar_lo) * 0.5 : na, "Asian Mid", color=color.new(color.blue, 60), linewidth=1, style=plot.style_linebr)

// ── TRUTH PANEL ───────────────────────────────────────────────────────────────
bias_str  = swing_dir == 1 ? "BUY" : swing_dir == -1 ? "SELL" : "FLAT"
bias_col  = swing_dir == 1 ? color.lime : swing_dir == -1 ? color.red : color.gray
tier_str  = tier == 0 ? "N/A" : "T" + str.tostring(tier)
tier_col  = tier == 1 ? color.lime : tier == 2 ? color.yellow : tier == 3 ? color.orange : color.gray
range_str = na(ar_pips) ? "--" : str.tostring(math.round(ar_pips)) + "p"
_dt       = str.format("{0,date,yyyyMMdd}", time)
_hm       = str.format("{0,date,HHmm}", time)
state_id  = "EURUSD_" + _dt + "_" + _hm + "_" + bias_str + "_v5"
valid_str = str.format("{0,date,HH:mm}", time_close)

var table tp = table.new(position.top_right, 2, 7, bgcolor=color.new(color.black, 8), border_width=1, border_color=color.new(color.gray, 50), frame_width=1, frame_color=color.new(color.gray, 30))

if i_show_panel and barstate.islast
    table.cell(tp, 0, 0, "CEREBUS v5",  text_color=color.white,  text_size=size.small,  bgcolor=color.new(color.navy, 15), text_halign=text.align_center)
    table.cell(tp, 1, 0, "TRAP",        text_color=color.orange, text_size=size.small,  bgcolor=color.new(color.navy, 15), text_halign=text.align_center)
    table.cell(tp, 0, 1, "SIDE",        text_color=color.white,  text_size=size.normal, text_halign=text.align_left)
    table.cell(tp, 1, 1, bias_str,      text_color=bias_col,     text_size=size.normal, text_halign=text.align_center)
    table.cell(tp, 0, 2, "TIER",        text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 2, tier_str,      text_color=tier_col,     text_size=size.small,  text_halign=text.align_center)
    table.cell(tp, 0, 3, "RANGE",       text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 3, range_str,     text_color=color.silver, text_size=size.small,  text_halign=text.align_center)
    table.cell(tp, 0, 4, "ATOM",        text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 4, str.tostring(atomic_pips, "#") + "p", text_color=color.aqua, text_size=size.small, text_halign=text.align_center)
    table.cell(tp, 0, 5, "STATE ID",    text_color=color.white,  text_size=size.tiny,   text_halign=text.align_left)
    table.cell(tp, 1, 5, state_id,      text_color=color.yellow, text_size=size.tiny,   text_halign=text.align_center)
    table.cell(tp, 0, 6, "VALID UNTIL", text_color=color.white,  text_size=size.tiny,   text_halign=text.align_left)
    table.cell(tp, 1, 6, valid_str,     text_color=color.white,  text_size=size.tiny,   text_halign=text.align_center)

alertcondition(long_entry,  "CEREBUS Long Entry",  "CEREBUS LONG | {{ticker}} | {{timenow}} | {{close}}")
alertcondition(short_entry, "CEREBUS Short Entry", "CEREBUS SELL | {{ticker}} | {{timenow}} | {{close}}")
