//@version=6
// =============================================================================
// CEREBUS Symmetry Trap v5.0 — Atomic Dynamic Engine
// =============================================================================
// PROTOCOL (exact, from strategy context.txt):
//
//   PRE-SESSION (1:45 AM EST):
//     1. Measure Asian Range (7PM - 3AM EST)
//     2. Classify Tier → load Base Trigger, Density Zone, Atomic Target
//     3. First Impulse Predictor: watch 3AM-4AM for early tier upgrade
//
//   ANCHOR (3AM - 9AM EST):
//     4. Wait for candle that breaks Asian H/L
//        - Breakout size ≥ Base Trigger (pair/tier specific)
//        - Candle body ≥ 4.5 pips
//     5. Lock Session_Direction
//
//   ENTRY (Symmetry Trap):
//     6. Track Peak from anchor high (bull) or trough (bear)
//     7. Wait: pullback depth [Peak - Low] in Density Zone (e.g. EUR T1: 8-12p)
//     8. Entry: candle in session direction with body ≥ 4.5 pips closing in zone
//
//   TARGETS:
//     9.  A-Leg: +Atomic Target pips from entry → close 80%, SL to BE+2p
//     10. B-C Leg: trail 20% to Daily-50% or hard exit 12PM EST
//
//   EWS (30-60 mins after entry):
//     11. Opposite candle body ≥ 4.5p → EXIT IMMEDIATELY (100%)
//
//   FILTERS:
//     12. NO-GO if Asian Range > max threshold
//     13. Overfilled: daily range > 40p (T1/T2) or 50p (T3) by 9AM → stand down
//     14. Thursday Rule: false anchor within 30 mins → wait for opposite
//
// TRUTH PANEL (MCP-readable): SIDE|TIER|ATOM|RANGE|MODEL|STATE ID|VALID UNTIL
// =============================================================================

indicator("CEREBUS Symmetry Trap v5", overlay=true,
     max_lines_count=500, max_boxes_count=200, max_labels_count=200)

// ─── INPUTS ──────────────────────────────────────────────────────────────────
var string GRP_SESS = "Session (EST Times)"
var string GRP_FILT = "Filters"
var string GRP_DISP = "Display"

i_tz           = input.string("America/New_York", "Timezone", group=GRP_SESS,
     options=["America/New_York","UTC","Europe/London"])
i_hard_exit_h  = input.int(12, "Hard Exit Hour (EST)", minval=10, maxval=17, group=GRP_SESS)
i_fde_target   = input.float(50.0, "FDE Target ($)", minval=10, group=GRP_SESS)

i_show_grid    = input.bool(true,  "Show Atomic Grid",     group=GRP_DISP)
i_show_zones   = input.bool(true,  "Show Density Zones",   group=GRP_DISP)
i_show_signals = input.bool(true,  "Show Entry Signals",   group=GRP_DISP)
i_show_panel   = input.bool(true,  "Show Truth Panel",     group=GRP_DISP)
i_thursday     = input.bool(true,  "Thursday Rule",        group=GRP_FILT)
i_overfill     = input.bool(true,  "Overfilled Filter",    group=GRP_FILT)

// ─── CONSTANTS ────────────────────────────────────────────────────────────────
MIN_BODY_PIPS = 4.5   // Minimum significant candle body (all conditions)

// ─── PIP SIZE ─────────────────────────────────────────────────────────────────
_sym    = syminfo.ticker
_is_jpy = str.contains(_sym, "JPY")
_is_idx = str.contains(_sym, "US500") or str.contains(_sym, "SPX")
pip     = _is_idx ? 1.0 : _is_jpy ? 0.01 : 0.0001
min_body = MIN_BODY_PIPS * pip

// ─── ASSET PARAMETERS — EXACT FROM STRATEGY CONTEXT ──────────────────────────
//  [tier1_max, tier2_max, nogo_max]             ← Asian range thresholds (pips)
//  [trigger_t1, trigger_t2, trigger_t3]         ← Base Trigger (pips)
//  [dz_min_t1, dz_max_t1, ...]                  ← Density Zone (pips from peak)
//  [a_leg_t1, a_leg_t2, a_leg_t3]               ← Atomic A-Leg Target (pips)

_eu = str.contains(_sym, "EURUSD")
_gb = str.contains(_sym, "GBPUSD")
_uc = str.contains(_sym, "USDCHF") or str.contains(_sym, "CHFUSD")
_uj = str.contains(_sym, "USDJPY") or str.contains(_sym, "JPYUSD")
_au = str.contains(_sym, "AUDUSD")
_nu = str.contains(_sym, "NZDUSD")

// Tier thresholds (pips) — NO-GO above tier3_max
tier1_max_p = _eu?20 : _gb?24 : _uc?19 : _uj?28 : _au?22 : _nu?25 : 20
tier2_max_p = _eu?30 : _gb?34 : _uc?29 : _uj?42 : _au?33 : _nu?36 : 30
nogo_p      = _eu?45 : _gb?55 : _uc?50 : _uj?65 : _au?52 : _nu?55 : 45

// Base Trigger per tier (pips) — impulse must exceed this to lock bias
trig_t1_p   = _eu?12 : _gb?14 : _uc?11 : _uj?16 : _au?13 : _nu?15 : 12
trig_t2_p   = _eu?15 : _gb?18 : _uc?15 : _uj?22 : _au?17 : _nu?20 : 15
trig_t3_p   = _eu?19 : _gb?23 : _uc?20 : _uj?29 : _au?22 : _nu?26 : 19

// Density Zone min/max (pips pullback from peak)
dz_min_t1_p = _eu? 8 : _gb?13 : _uc?10 : _uj?15 : _au?12 : _nu?14 :  8
dz_max_t1_p = _eu?12 : _gb?15 : _uc?12 : _uj?17 : _au?14 : _nu?16 : 12
dz_min_t2_p = _eu?10 : _gb?17 : _uc?14 : _uj?21 : _au?16 : _nu?19 : 10
dz_max_t2_p = _eu?14 : _gb?19 : _uc?16 : _uj?23 : _au?18 : _nu?21 : 14
dz_min_t3_p = _eu?13 : _gb?22 : _uc?19 : _uj?28 : _au?21 : _nu?25 : 13
dz_max_t3_p = _eu?17 : _gb?24 : _uc?21 : _uj?30 : _au?23 : _nu?27 : 17

// A-Leg Atomic Targets (pips from entry)
aleg_t1_p   = _eu?10 : _gb?14 : _uc?11 : _uj?14 : _au?13 : _nu?15 : 10
aleg_t2_p   = _eu?14 : _gb?18 : _uc?15 : _uj?22 : _au?17 : _nu?20 : 14
aleg_t3_p   = _eu?18 : _gb?23 : _uc?20 : _uj?29 : _au?22 : _nu?26 : 18

// Convert to price
tier1_max = tier1_max_p * pip
tier2_max = tier2_max_p * pip
nogo_max  = nogo_p      * pip

// ─── SESSION TIME DETECTION ───────────────────────────────────────────────────
// Asian Range window: 7 PM - 3 AM EST (1900-0300)
// Bias window: 3 AM - 9 AM EST (0300-0900)
// Hard exit: 12 PM EST

asian_sess = "1900-0300"
bias_sess  = "0300-0900"

in_asian   = timeframe.isintraday and not na(time(timeframe.period, asian_sess, i_tz))
in_bias    = timeframe.isintraday and not na(time(timeframe.period, bias_sess,  i_tz))
in_hard_exit_window = hour(time, i_tz) >= i_hard_exit_h

asian_started = in_asian  and not in_asian[1]
asian_ended   = not in_asian and in_asian[1]
bias_started  = in_bias   and not in_bias[1]

// ─── ASIAN RANGE MEASUREMENT ──────────────────────────────────────────────────
var float asian_hi     = na
var float asian_lo     = na
var float locked_hi    = na
var float locked_lo    = na
var float asian_range  = na
var int   sess_tier    = 0
var float sess_trig    = na
var float sess_dz_min  = na
var float sess_dz_max  = na
var float sess_aleg    = na
var bool  sess_nogo    = false
var bool  sess_ready   = false

if asian_started
    asian_hi   := high
    asian_lo   := low
    sess_ready := false
    sess_nogo  := false

if in_asian and not asian_started
    asian_hi   := math.max(asian_hi, high)
    asian_lo   := math.min(asian_lo, low)

if asian_ended or (bias_started and not sess_ready)
    locked_hi  := asian_hi
    locked_lo  := asian_lo
    asian_range := locked_hi - locked_lo

    // Classify tier
    if asian_range > nogo_max
        sess_tier  := 0
        sess_nogo  := true
    else if asian_range <= tier1_max
        sess_tier  := 1
        sess_trig  := trig_t1_p * pip
        sess_dz_min := dz_min_t1_p * pip
        sess_dz_max := dz_max_t1_p * pip
        sess_aleg  := aleg_t1_p * pip
    else if asian_range <= tier2_max
        sess_tier  := 2
        sess_trig  := trig_t2_p * pip
        sess_dz_min := dz_min_t2_p * pip
        sess_dz_max := dz_max_t2_p * pip
        sess_aleg  := aleg_t2_p * pip
    else
        sess_tier  := 3
        sess_trig  := trig_t3_p * pip
        sess_dz_min := dz_min_t3_p * pip
        sess_dz_max := dz_max_t3_p * pip
        sess_aleg  := aleg_t3_p * pip
    sess_ready := true

// ─── FIRST IMPULSE PREDICTOR (3AM - 4AM EST) ──────────────────────────────────
// If early range <10p and first impulse >=12p -> upgrade to T2
// If early range <15p and first impulse >=18p -> upgrade to T3
// If early range <20p and first impulse >=25p -> NO-GO
fip_sess   = "0300-0400"
in_fip_window = timeframe.isintraday and not na(time(timeframe.period, fip_sess, i_tz))

var bool fip_checked = false
if asian_started or bias_started
    fip_checked := false

candle_body   = math.abs(close - open)
early_range_p = na(locked_hi) or na(locked_lo) ? 0.0 : (locked_hi - locked_lo) / pip

if in_fip_window and sess_ready and not fip_checked and not sess_nogo
    if early_range_p < 10 and candle_body >= 12 * pip
        // Upgrade to T2
        sess_tier   := 2
        sess_trig   := trig_t2_p * pip
        sess_dz_min := dz_min_t2_p * pip
        sess_dz_max := dz_max_t2_p * pip
        sess_aleg   := aleg_t2_p * pip
        fip_checked := true
    else if early_range_p < 15 and candle_body >= 18 * pip
        // Upgrade to T3
        sess_tier   := 3
        sess_trig   := trig_t3_p * pip
        sess_dz_min := dz_min_t3_p * pip
        sess_dz_max := dz_max_t3_p * pip
        sess_aleg   := aleg_t3_p * pip
        fip_checked := true
    else if early_range_p < 20 and candle_body >= 25 * pip
        // NO-GO
        sess_nogo   := true
        fip_checked := true

// ─── OVERFILLED FILTER ────────────────────────────────────────────────────────
// By 9AM: if daily range > 40p (T1/T2) or 50p (T3) -> stand down
daily_hi_so_far = ta.highest(high, 108)  // ~9h of M5 bars since midnight
daily_lo_so_far = ta.lowest(low,  108)
daily_range_p   = (daily_hi_so_far - daily_lo_so_far) / pip

overfill_threshold_p = sess_tier == 3 ? 50.0 : 40.0
overfilled = i_overfill and sess_ready and not na(time(timeframe.period, "0900-1200", i_tz)) and
             daily_range_p > overfill_threshold_p

// ─── ANCHOR: BIAS LOCK ────────────────────────────────────────────────────────
// Breaking candle must:
//   - Close above Asian High (bull) or below Asian Low (bear)
//   - Breakout distance >= Base Trigger
//   - Candle body >= 4.5p

var int   locked_dir   = 0      // 1=BULL, -1=BEAR
var float anchor_px    = na     // close of anchor candle
var int   anchor_bar   = na
var bool  bias_locked  = false
var float peak_price   = na     // highest high since anchor (bull) or lowest low (bear)

// Thursday rule state
var bool  false_anchor = false
var int   thursday_flips = 0

if asian_started or bias_started
    locked_dir    := 0
    bias_locked   := false
    anchor_px     := na
    anchor_bar    := na
    peak_price    := na
    false_anchor  := false

bull_anchor_cond = sess_ready and not sess_nogo and not bias_locked and in_bias and not overfilled and
     close > locked_hi and
     (close - locked_hi) >= sess_trig and
     candle_body >= min_body and
     close > open

bear_anchor_cond = sess_ready and not sess_nogo and not bias_locked and in_bias and not overfilled and
     close < locked_lo and
     (locked_lo - close) >= sess_trig and
     candle_body >= min_body and
     close < open

// Thursday rule: if first anchor fails (price closes back inside Asian range within 30 min = 6 bars)
// Tracked after anchor to allow opposite side only
is_thursday   = dayofweek == dayofweek.thursday

if bull_anchor_cond and not (is_thursday and i_thursday and thursday_flips == 0 and false_anchor)
    locked_dir  := 1
    bias_locked := true
    anchor_px   := close
    anchor_bar  := bar_index
    peak_price  := high

if bear_anchor_cond and not (is_thursday and i_thursday and thursday_flips == 0 and false_anchor)
    locked_dir  := -1
    bias_locked := true
    anchor_px   := close
    anchor_bar  := bar_index
    peak_price  := low

// Track peak after anchor
if bias_locked and locked_dir == 1
    peak_price := math.max(peak_price, high)
if bias_locked and locked_dir == -1
    peak_price := math.min(peak_price, low)

// Thursday false anchor: if price closes back inside Asian range within 6 bars
if bias_locked and is_thursday and i_thursday and not na(anchor_bar)
    if locked_dir == 1 and close < locked_hi and (bar_index - anchor_bar) <= 6
        false_anchor  := true
        bias_locked   := false
        locked_dir    := 0
        thursday_flips += 1
    if locked_dir == -1 and close > locked_lo and (bar_index - anchor_bar) <= 6
        false_anchor  := true
        bias_locked   := false
        locked_dir    := 0
        thursday_flips += 1

// ─── PULLBACK DEPTH CALCULATION ───────────────────────────────────────────────
// Bull: how far price has pulled back from peak (pip distance)
// Bear: how far price has pulled back up from trough (pip distance)
pullback_depth = bias_locked and not na(peak_price) ?
     (locked_dir == 1 ? (peak_price - low)  / pip :
      locked_dir == -1 ? (high - peak_price) / pip : 0.0) : 0.0

in_density_zone = bias_locked and
     pullback_depth >= (sess_dz_min / pip) and
     pullback_depth <= (sess_dz_max / pip)

// ─── ENTRY SIGNAL ─────────────────────────────────────────────────────────────
// Candle closes in density zone, moves in session direction, body >= 4.5p
// Long: bullish candle (close > open, body >= min_body) while in zone
// Short: bearish candle (close < open, body >= min_body) while in zone

var int   entries_sess = 0
var bool  in_trade     = false
var int   trade_dir    = 0
var float entry_px     = na
var float aleg_px      = na
var float be_px        = na
var int   entry_bar    = na
var int   entry_minute = na    // bars since entry (for EWS window)

if asian_started
    entries_sess := 0
    in_trade     := false
    trade_dir    := 0

long_entry  = bias_locked and locked_dir == 1 and in_density_zone and
              close > open and candle_body >= min_body and
              not in_trade and entries_sess < 2 and in_bias and
              barstate.isconfirmed

short_entry = bias_locked and locked_dir == -1 and in_density_zone and
              close < open and candle_body >= min_body and
              not in_trade and entries_sess < 2 and in_bias and
              barstate.isconfirmed

if long_entry
    in_trade      := true
    trade_dir     := 1
    entry_px      := close
    aleg_px       := close + sess_aleg
    be_px         := close
    entry_bar     := bar_index
    entries_sess  += 1

if short_entry
    in_trade      := true
    trade_dir     := -1
    entry_px      := close
    aleg_px       := close - sess_aleg
    be_px         := close
    entry_bar     := bar_index
    entries_sess  += 1

// ─── A-LEG TARGET ─────────────────────────────────────────────────────────────
a_leg_hit_l = in_trade and trade_dir == 1  and high  >= aleg_px
a_leg_hit_s = in_trade and trade_dir == -1 and low   <= aleg_px

if a_leg_hit_l or a_leg_hit_s
    // 80% closed at A-leg, SL moved to BE+2p, 20% continues as runner
    be_px    := entry_px + (trade_dir == 1 ? 2 * pip : -2 * pip)
    // (In live execution the partial close would happen here)

// ─── HARD EXIT (12PM EST) ─────────────────────────────────────────────────────
hard_exit = in_trade and in_hard_exit_window and barstate.isconfirmed

// ─── EWS: OPPOSITE P90 (30-60 mins after entry) ───────────────────────────────
// "P90" in this system = any candle with body >= 4.5p against the trade
// Window: 30-60 minutes = 6-12 bars on M5
bars_since_entry = na(entry_bar) ? 0 : bar_index - entry_bar
ews_window       = bars_since_entry >= 6 and bars_since_entry <= 12

opp_candle_body = candle_body >= min_body
ews_exit_l = in_trade and trade_dir == 1  and ews_window and close < open and opp_candle_body
ews_exit_s = in_trade and trade_dir == -1 and ews_window and close > open and opp_candle_body

trade_exit = a_leg_hit_l or a_leg_hit_s or ews_exit_l or ews_exit_s or hard_exit

if trade_exit
    in_trade  := false
    trade_dir := 0

// ─── CURRENT SIDE FOR TRUTH PANEL ─────────────────────────────────────────────
// Bias = locked direction from anchor (BUY/SELL), FLAT if not locked
current_side  = locked_dir == 1 ? "BUY" : locked_dir == -1 ? "SELL" : "FLAT"
side_col      = locked_dir == 1 ? color.new(color.lime,0) :
                locked_dir == -1 ? color.new(color.red,0) : color.new(color.gray,0)
tier_str      = sess_tier == 0 ? "NO-GO" : "T" + str.tostring(sess_tier)
tier_col      = sess_tier == 1 ? color.new(color.lime,0) :
                sess_tier == 2 ? color.new(color.yellow,0) :
                sess_tier == 3 ? color.new(color.orange,0) : color.new(color.red,0)
range_str     = na(asian_range) ? "--" : str.tostring(math.round(asian_range / pip)) + "p"
aleg_str      = na(sess_aleg)   ? "--" : str.tostring(math.round(sess_aleg   / pip)) + "p"

_date     = str.format("{0,date,yyyyMMdd}", time)
_hm       = str.format("{0,date,HHmm}",    time)
state_id  = _sym + "_" + _date + "_" + _hm + "_" + current_side + "_v5"
valid_str = str.format("{0,date,HH:mm}", time_close)

// ─── VISUALS: ENTRY SIGNALS ───────────────────────────────────────────────────
plotshape(i_show_signals and long_entry,
     title="Long Entry", location=location.belowbar,
     style=shape.triangleup, color=color.new(color.lime,0), size=size.normal)
plotshape(i_show_signals and short_entry,
     title="Short Entry", location=location.abovebar,
     style=shape.triangledown, color=color.new(color.red,0), size=size.normal)
plotshape(i_show_signals and (ews_exit_l or ews_exit_s),
     title="EWS Exit", location=location.belowbar,
     style=shape.xcross, color=color.new(color.orange,0), size=size.small)
plotshape(i_show_signals and hard_exit,
     title="Hard Exit 12PM", location=location.abovebar,
     style=shape.square, color=color.new(color.gray,0), size=size.tiny)

// ─── VISUALS: ASIAN RANGE LINES ───────────────────────────────────────────────
plot(sess_ready ? locked_hi : na, "Asian High", color=color.new(color.blue,40), linewidth=2, style=plot.style_linebr)
plot(sess_ready ? locked_lo : na, "Asian Low",  color=color.new(color.blue,40), linewidth=2, style=plot.style_linebr)
plot(sess_ready ? (locked_hi + locked_lo) * 0.5 : na, "Asian Mid",
     color=color.new(color.blue,70), linewidth=1, style=plot.style_linebr)

// ─── VISUALS: ATOMIC GRID (from Asian H/L in atom-sized steps) ────────────────
if i_show_grid and sess_ready and not sess_nogo and barstate.islast
    for i = 1 to 8
        line.new(bar_index - 300, locked_hi + i * sess_aleg, bar_index + 60, locked_hi + i * sess_aleg,
             color=color.new(color.teal, 70), style=line.style_dotted, width=1)
        line.new(bar_index - 300, locked_lo - i * sess_aleg, bar_index + 60, locked_lo - i * sess_aleg,
             color=color.new(color.teal, 70), style=line.style_dotted, width=1)

// ─── VISUALS: DENSITY ZONE BOXES ──────────────────────────────────────────────
var box bull_box = na
var box bear_box = na

if i_show_zones and barstate.islast and bias_locked and not na(peak_price)
    if locked_dir == 1
        dz_top = peak_price - sess_dz_min
        dz_bot = peak_price - sess_dz_max
        if not na(bull_box)
            box.delete(bull_box)
        bull_box := box.new(anchor_bar, dz_top, bar_index + 30, dz_bot,
             bgcolor=color.new(color.lime, 88),
             border_color=color.new(color.lime, 40), border_style=line.style_dashed)
    if locked_dir == -1
        dz_top = peak_price + sess_dz_max
        dz_bot = peak_price + sess_dz_min
        if not na(bear_box)
            box.delete(bear_box)
        bear_box := box.new(anchor_bar, dz_top, bar_index + 30, dz_bot,
             bgcolor=color.new(color.red, 88),
             border_color=color.new(color.red, 40), border_style=line.style_dashed)

// ─── VISUALS: A-LEG TARGET LINE ───────────────────────────────────────────────
var line aleg_line = na
if in_trade and not na(entry_bar) and barstate.islast
    if not na(aleg_line)
        line.delete(aleg_line)
    aleg_line := line.new(entry_bar, aleg_px, bar_index + 30, aleg_px,
         color=color.new(color.yellow, 15), style=line.style_dashed, width=2)

// ─── TRUTH PANEL ──────────────────────────────────────────────────────────────
// Rows are " | "-delimited — MCP reads: data_get_pine_tables(study_filter="CEREBUS")
var table tp = table.new(position.top_right, 2, 8,
     bgcolor=color.new(color.black, 8),
     border_width=1, border_color=color.new(color.gray, 50),
     frame_width=1,  frame_color=color.new(color.gray, 30))

if i_show_panel and barstate.islast
    table.cell(tp, 0, 0, "CEREBUS v5",
         text_color=color.new(color.white,0), text_size=size.small,
         bgcolor=color.new(color.navy,15), text_halign=text.align_center)
    table.cell(tp, 1, 0, "TRAP",
         text_color=color.new(color.orange,0), text_size=size.small,
         bgcolor=color.new(color.navy,15), text_halign=text.align_center)

    table.cell(tp, 0, 1, "SIDE",
         text_color=color.new(color.white,0), text_size=size.normal, text_halign=text.align_left)
    table.cell(tp, 1, 1, current_side,
         text_color=side_col, text_size=size.normal, text_halign=text.align_center)

    table.cell(tp, 0, 2, "TIER",
         text_color=color.new(color.white,0), text_size=size.small, text_halign=text.align_left)
    table.cell(tp, 1, 2, tier_str,
         text_color=tier_col, text_size=size.small, text_halign=text.align_center)

    table.cell(tp, 0, 3, "RANGE",
         text_color=color.new(color.white,0), text_size=size.small, text_halign=text.align_left)
    table.cell(tp, 1, 3, range_str,
         text_color=color.new(color.silver,0), text_size=size.small, text_halign=text.align_center)

    table.cell(tp, 0, 4, "A-LEG",
         text_color=color.new(color.white,0), text_size=size.small, text_halign=text.align_left)
    table.cell(tp, 1, 4, aleg_str,
         text_color=color.new(color.aqua,0), text_size=size.small, text_halign=text.align_center)

    table.cell(tp, 0, 5, "MODEL",
         text_color=color.new(color.white,0), text_size=size.small, text_halign=text.align_left)
    table.cell(tp, 1, 5, "CEREBUS_IMPULSE",
         text_color=color.new(color.white,0), text_size=size.small, text_halign=text.align_center)

    table.cell(tp, 0, 6, "STATE ID",
         text_color=color.new(color.white,0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tp, 1, 6, state_id,
         text_color=color.new(color.yellow,0), text_size=size.tiny, text_halign=text.align_center)

    table.cell(tp, 0, 7, "VALID UNTIL",
         text_color=color.new(color.white,0), text_size=size.tiny, text_halign=text.align_left)
    table.cell(tp, 1, 7, valid_str,
         text_color=color.new(color.white,0), text_size=size.tiny, text_halign=text.align_center)

// ─── ALERT CONDITIONS ─────────────────────────────────────────────────────────
// Use these alert conditions to wire to the webhook system.
// Alert message JSON (paste in TradingView alert dialog):
//
// LONG:
// {"signal_id":"{{ticker}}_{{timenow}}_BUY","symbol":"{{ticker}}","action":"BUY",
//  "signal_type":"IMPULSE","strategy_name":"CEREBUS_IMPULSE",
//  "timestamp":"{{timenow}}","timeframe":"{{interval}}","price":{{close}},
//  "session":"NY","state_id":"{{ticker}}_{{timenow}}_BUY"}
//
// SHORT:
// {"signal_id":"{{ticker}}_{{timenow}}_SELL","symbol":"{{ticker}}","action":"SELL",
//  "signal_type":"IMPULSE","strategy_name":"CEREBUS_IMPULSE",
//  "timestamp":"{{timenow}}","timeframe":"{{interval}}","price":{{close}},
//  "session":"NY","state_id":"{{ticker}}_{{timenow}}_SELL"}
//
// EWS / HARD EXIT:
// {"signal_id":"{{ticker}}_{{timenow}}_CLOSE","symbol":"{{ticker}}","action":"CLOSE",
//  "signal_type":"REBALANCE","strategy_name":"CEREBUS_REBALANCE",
//  "timestamp":"{{timenow}}","timeframe":"{{interval}}","price":{{close}},
//  "session":"NY","state_id":"{{ticker}}_{{timenow}}_CLOSE"}

alertcondition(long_entry,
     title="CEREBUS Long Entry",
     message="CEREBUS LONG | {{ticker}} | {{timenow}} | {{close}}")
alertcondition(short_entry,
     title="CEREBUS Short Entry",
     message="CEREBUS SELL | {{ticker}} | {{timenow}} | {{close}}")
alertcondition(ews_exit_l or ews_exit_s,
     title="CEREBUS EWS Exit",
     message="CEREBUS EWS | {{ticker}} | {{timenow}} | {{close}}")
alertcondition(hard_exit,
     title="CEREBUS Hard Exit 12PM",
     message="CEREBUS HARD EXIT | {{ticker}} | {{timenow}} | {{close}}")
alertcondition(a_leg_hit_l or a_leg_hit_s,
     title="CEREBUS A-Leg Hit",
     message="CEREBUS ALEG | {{ticker}} | {{timenow}} | {{close}}")
