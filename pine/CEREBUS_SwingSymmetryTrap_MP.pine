//@version=6
// CEREBUS Swing Symmetry Trap [MP]
// Base: Symmetry Sniper [MP] — all ATOM/TIER logic intact
// Added: Swing layer — Asian Range bias lock + distribution targets + atomic entry
// Swing logic gated by i_swing_enable — zero impact on ATOM/TIER if disabled
//
// SWING LOGIC:
//   1. After 3AM: measure Asian Range, lock T25/T50/T100 distribution targets
//   2. First close outside Asian band = SWING BIAS locked (LONG above ar_hi, SHORT below ar_lo)
//   3. Atomic impulse in bias direction + pullback = SWING ENTRY
//   4. SL = opposite band extreme (ar_lo for LONG, ar_hi for SHORT)
//   5. Targets: T25=25% AR extension, T50=50%, T100=100%
//   6. Hard exit at 12PM EST (3PM crypto)
//   7. Structural invalidation: close back inside Asian band
// All 3 signal types (ATOM/TIER/SWING) send full Copygram JSON via alert()

indicator("CEREBUS Swing Symmetry Trap [MP]", overlay=true,
     max_lines_count=500, max_boxes_count=200, max_labels_count=500)

i_tz         = input.string("America/New_York", "Timezone", options=["America/New_York","UTC","Europe/London"])
i_show_tier  = input.bool(true, "Show Tier Impulses")
i_show_atom  = input.bool(true, "Show Atomic Moves")
i_show_dz    = input.bool(true, "Show Density Zone")
i_show_panel = input.bool(true, "Show Truth Panel")

i_swing_enable = input.bool(true,  "Enable Swing Layer",   group="Swing")
i_swing_target = input.string("T50","Primary Target",      group="Swing", options=["T25","T50","T100"])
i_swing_scale  = input.bool(true,  "Scale Out at T25",     group="Swing")
i_swing_be     = input.bool(true,  "Move SL to BE at T25", group="Swing")
i_show_swing   = input.bool(true,  "Show Swing Visuals",   group="Swing")

DZ_LO = 0.80
DZ_HI = 1.20

_sym    = syminfo.ticker
_eu     = str.contains(_sym, "EURUSD")
_uc     = str.contains(_sym, "USDCHF")
_btc    = str.contains(_sym, "BTC")
_eth    = str.contains(_sym, "ETH")
_xau    = str.contains(_sym, "XAUUSD") or str.contains(_sym, "GOLD")
_nas    = str.contains(_sym, "NAS100") or str.contains(_sym, "USTEC") or str.contains(_sym, "US100") or str.contains(_sym, "NASDAQ")
_de30   = str.contains(_sym, "DE30") or str.contains(_sym, "GER40") or str.contains(_sym, "DAX")
_fr40   = str.contains(_sym, "FR40") or str.contains(_sym, "CAC40")
_hk50   = str.contains(_sym, "HK50") or str.contains(_sym, "HSI")
_chfjpy = str.contains(_sym, "CHFJPY")
_idx    = _de30 or _fr40

pair_supported = _eu or _uc or _btc or _eth or _xau or _nas or _idx or _hk50 or _chfjpy
pip = _btc or _eth or _xau or _nas or _idx or _hk50 ? 1.0 : _chfjpy ? 0.01 : 0.0001

T1_ar_p   = _btc?750.0  :_eth?70.0  :_xau?32.0 :_nas?68.0  :_idx?39.0 :_hk50?185.0:_chfjpy?28.0:20.0
T2_ar_p   = _btc?1700.0 :_eth?105.0 :_xau?58.0 :_nas?128.0 :_idx?74.0 :_hk50?340.0:_chfjpy?48.0:30.0
T3_ar_p   = _btc?3000.0 :_eth?160.0 :_xau?95.0 :_nas?245.0 :_idx?142.0:_hk50?650.0:_chfjpy?85.0:45.0
T1_trig_p = _btc?246.0  :_eth?42.0  :_xau?19.0 :_nas?41.0  :_idx?23.0 :_hk50?110.0:_chfjpy?17.0:12.0
T2_trig_p = _btc?654.0  :_eth?52.0  :_xau?35.0 :_nas?77.0  :_idx?44.0 :_hk50?204.0:_chfjpy?29.0:15.0
T3_trig_p = _btc?1392.0 :_eth?65.0  :_xau?58.0 :_nas?146.0 :_idx?85.0 :_hk50?390.0:_chfjpy?50.0:19.0
T1_atom_p = _btc?205.0  :_eth?35.0  :_xau?16.0 :_nas?34.0  :_idx?19.0 :_hk50?92.0 :_chfjpy?14.0:10.0
T2_atom_p = _btc?545.0  :_eth?42.0  :_xau?29.0 :_nas?64.0  :_idx?37.0 :_hk50?170.0:_chfjpy?24.0:12.0
T3_atom_p = _btc?1160.0 :_eth?52.0  :_xau?48.0 :_nas?122.0 :_idx?71.0 :_hk50?325.0:_chfjpy?42.0:15.0

sl_buf_p = _btc?25.0:_eth?5.0:_xau?4.0:_nas?12.0:_idx?7.0:_hk50?35.0:5.0
sl_buf   = sl_buf_p * pip

MIN_P       = T1_atom_p
atom_buffer = 0.90

f_atom(_t)            => _t == 1 ? T1_atom_p : _t == 2 ? T2_atom_p : T3_atom_p
f_tier_from_move(_p)  => _p >= T3_trig_p ? 3 : _p >= T2_trig_p ? 2 : 1
f_tier_from_range(_p) => _p <= T1_ar_p   ? 1 : _p <= T2_ar_p   ? 2 : _p <= T3_ar_p ? 3 : 0

asian_sess    = "1900-0300"
is_crypto     = _btc or _eth
bias_sess     = is_crypto ? "0300-1500" : "0300-1200"
in_asian      = timeframe.isintraday and not na(time(timeframe.period, asian_sess, i_tz))
in_bias       = timeframe.isintraday and not na(time(timeframe.period, bias_sess,  i_tz))
asian_started = in_asian and not in_asian[1]
asian_ended   = not in_asian and in_asian[1]
bias_started  = in_bias and not in_bias[1]

var float ar_hi = na
var float ar_lo = na

if asian_started
    ar_hi := high
    ar_lo := low
if in_asian and not asian_started
    ar_hi := math.max(ar_hi, high)
    ar_lo := math.min(ar_lo, low)

// Existing state
var float swing_origin   = na
var int   swing_sbar     = na
var float swing_spx      = na
var float rolling_hi     = na
var float rolling_lo     = na
var int   rolling_hi_bar = na
var int   rolling_lo_bar = na
var int   working_tier   = 1
var bool  tier_ok        = false
var float dz_origin      = na
var int   dz_dir         = 0
var box   dz_box         = na

// Swing state
var bool  sw_bias_locked = false
var int   sw_bias_dir    = 0
var float sw_ar          = na
var float sw_t25         = na
var float sw_t50         = na
var float sw_t100        = na
var bool  sw_active      = false
var float sw_entry_px    = na
var float sw_sl_px       = na
var float sw_tp_px       = na
var float sw_be_px       = na
var bool  sw_t25_hit     = false
var bool  sw_t50_hit     = false
var bool  sw_t100_hit    = false
var line  sw_t25_line    = na
var line  sw_t50_line    = na
var line  sw_t100_line   = na

if bias_started
    swing_origin   := close
    swing_sbar     := bar_index
    swing_spx      := close
    rolling_hi     := high
    rolling_lo     := low
    rolling_hi_bar := bar_index
    rolling_lo_bar := bar_index
    dz_dir         := 0
    tier_ok        := false
    working_tier   := 1
    sw_bias_locked := false
    sw_bias_dir    := 0
    sw_ar          := na
    sw_t25         := na
    sw_t50         := na
    sw_t100        := na
    sw_active      := false
    sw_entry_px    := na
    sw_sl_px       := na
    sw_tp_px       := na
    sw_be_px       := na
    sw_t25_hit     := false
    sw_t50_hit     := false
    sw_t100_hit    := false

if asian_ended and not tier_ok and not na(ar_hi) and not na(ar_lo)
    ar_range = (ar_hi - ar_lo) / pip
    final_t  = f_tier_from_range(ar_range)
    if final_t != 0
        working_tier := final_t
        tier_ok      := true
        if dz_dir != 0 and not na(dz_origin) and not na(dz_box)
            new_atom = f_atom(working_tier) * pip
            if dz_dir == -1
                box.set_top(dz_box, dz_origin - new_atom * DZ_LO)
                box.set_bottom(dz_box, dz_origin - new_atom * DZ_HI)
            else
                box.set_top(dz_box, dz_origin + new_atom * DZ_HI)
                box.set_bottom(dz_box, dz_origin + new_atom * DZ_LO)
    if i_swing_enable and not na(ar_hi) and not na(ar_lo)
        sw_ar := ar_hi - ar_lo

if na(swing_origin) and barstate.isconfirmed
    swing_origin   := close
    rolling_hi     := high
    rolling_lo     := low
    rolling_hi_bar := bar_index
    rolling_lo_bar := bar_index
    swing_sbar     := bar_index
    swing_spx      := close

if not na(rolling_hi) and high > rolling_hi
    rolling_hi     := high
    rolling_hi_bar := bar_index
if not na(rolling_lo) and low < rolling_lo
    rolling_lo     := low
    rolling_lo_bar := bar_index

up_move_p   = not na(rolling_hi) and not na(swing_origin) ? (rolling_hi - swing_origin) / pip : 0.0
down_move_p = not na(rolling_lo) and not na(swing_origin) ? (swing_origin - rolling_lo)  / pip : 0.0

cur_atom_p = working_tier == 1 ? T1_atom_p : working_tier == 2 ? T2_atom_p : T3_atom_p
cur_trig_p = working_tier == 1 ? T1_trig_p : working_tier == 2 ? T2_trig_p : T3_trig_p

bear_atom_cond = pair_supported and in_bias and tier_ok and up_move_p >= (cur_atom_p * atom_buffer) and up_move_p < cur_trig_p and close < open and barstate.isconfirmed
bull_atom_cond = pair_supported and in_bias and tier_ok and down_move_p >= (cur_atom_p * atom_buffer) and down_move_p < cur_trig_p and close > open and barstate.isconfirmed
bear_tier_cond = pair_supported and in_bias and up_move_p >= T1_trig_p and close < open and barstate.isconfirmed
bull_tier_cond = pair_supported and in_bias and down_move_p >= T1_trig_p and close > open and barstate.isconfirmed

cur_atom = f_atom(working_tier) * pip
dz_top   = dz_dir == -1 ? dz_origin - cur_atom * DZ_LO : dz_dir == 1 ? dz_origin + cur_atom * DZ_HI : na
dz_bot   = dz_dir == -1 ? dz_origin - cur_atom * DZ_HI : dz_dir == 1 ? dz_origin + cur_atom * DZ_LO : na
in_dz    = not na(dz_top) and not na(dz_bot) and close <= dz_top and close >= dz_bot

unit_str = pip == 1.0 ? "pt" : "p"

// Swing bias lock
if i_swing_enable and in_bias and not sw_bias_locked and not na(ar_hi) and not na(ar_lo) and not na(sw_ar) and barstate.isconfirmed
    if close > ar_hi
        sw_bias_locked := true
        sw_bias_dir    := 1
        sw_t25         := ar_hi + sw_ar * 0.25
        sw_t50         := ar_hi + sw_ar * 0.50
        sw_t100        := ar_hi + sw_ar * 1.00
        if i_show_swing
            label.new(bar_index, ar_hi, text="SWING BIAS\nLONG", style=label.style_label_down, color=color.new(color.orange, 20), textcolor=color.white, size=size.tiny)
    else if close < ar_lo
        sw_bias_locked := true
        sw_bias_dir    := -1
        sw_t25         := ar_lo - sw_ar * 0.25
        sw_t50         := ar_lo - sw_ar * 0.50
        sw_t100        := ar_lo - sw_ar * 1.00
        if i_show_swing
            label.new(bar_index, ar_lo, text="SWING BIAS\nSHORT", style=label.style_label_up, color=color.new(color.orange, 20), textcolor=color.white, size=size.tiny)

if i_swing_enable and i_show_swing and sw_bias_locked and not na(sw_t25) and barstate.islast
    if not na(sw_t25_line)
        line.delete(sw_t25_line)
    if not na(sw_t50_line)
        line.delete(sw_t50_line)
    if not na(sw_t100_line)
        line.delete(sw_t100_line)
    sw_t25_line  := line.new(bar_index - 50, sw_t25,  bar_index + 30, sw_t25,  color=color.new(color.yellow, 30), style=line.style_dotted, width=1)
    sw_t50_line  := line.new(bar_index - 50, sw_t50,  bar_index + 30, sw_t50,  color=color.new(color.orange, 10), style=line.style_dashed, width=2)
    sw_t100_line := line.new(bar_index - 50, sw_t100, bar_index + 30, sw_t100, color=color.new(color.red,    20), style=line.style_dotted, width=1)

// ATOM SHORT
if bear_atom_cond
    if i_show_atom
        label.new(rolling_hi_bar, rolling_hi, text="ATOM " + str.tostring(math.round(up_move_p)) + unit_str, style=label.style_label_down, color=color.new(color.aqua, 25), textcolor=color.white, size=size.tiny)
    au_px   = f_atom(working_tier) * pip
    sl_px   = high + sl_buf
    tp_px   = close - au_px
    be_px   = close - au_px * 0.50
    risk_px = math.max(sl_px - close, pip)
    r_val   = au_px / risk_px
    alert("{\"action\":\"sell\",\"symbol\":\"" + _sym + "\",\"entry\":\"" + str.tostring(close, format.mintick) + "\",\"stop_loss\":\"" + str.tostring(sl_px, format.mintick) + "\",\"take_profit\":\"" + str.tostring(tp_px, format.mintick) + "\",\"message\":\"ATOM SHORT " + _sym + " | Entry:" + str.tostring(close, format.mintick) + " SL:" + str.tostring(sl_px, format.mintick) + " TP:" + str.tostring(tp_px, format.mintick) + " BE:" + str.tostring(be_px, format.mintick) + " R:" + str.tostring(r_val, "#.##") + "R\"}", alert.freq_once_per_bar_close)
    swing_origin := rolling_hi
    swing_sbar   := rolling_hi_bar
    swing_spx    := rolling_hi
    rolling_hi   := high
    rolling_lo   := low
    rolling_hi_bar := bar_index
    rolling_lo_bar := bar_index

// ATOM LONG
if bull_atom_cond
    if i_show_atom
        label.new(rolling_lo_bar, rolling_lo, text="ATOM " + str.tostring(math.round(down_move_p)) + unit_str, style=label.style_label_up, color=color.new(color.fuchsia, 25), textcolor=color.white, size=size.tiny)
    au_px   = f_atom(working_tier) * pip
    sl_px   = low - sl_buf
    tp_px   = close + au_px
    be_px   = close + au_px * 0.50
    risk_px = math.max(close - sl_px, pip)
    r_val   = au_px / risk_px
    alert("{\"action\":\"buy\",\"symbol\":\"" + _sym + "\",\"entry\":\"" + str.tostring(close, format.mintick) + "\",\"stop_loss\":\"" + str.tostring(sl_px, format.mintick) + "\",\"take_profit\":\"" + str.tostring(tp_px, format.mintick) + "\",\"message\":\"ATOM LONG " + _sym + " | Entry:" + str.tostring(close, format.mintick) + " SL:" + str.tostring(sl_px, format.mintick) + " TP:" + str.tostring(tp_px, format.mintick) + " BE:" + str.tostring(be_px, format.mintick) + " R:" + str.tostring(r_val, "#.##") + "R\"}", alert.freq_once_per_bar_close)
    swing_origin := rolling_lo
    swing_sbar   := rolling_lo_bar
    swing_spx    := rolling_lo
    rolling_hi   := high
    rolling_lo   := low
    rolling_hi_bar := bar_index
    rolling_lo_bar := bar_index

// TIER SHORT
if bear_tier_cond
    anchor     = rolling_hi
    anchor_bar = rolling_hi_bar
    sig_pips   = math.round(up_move_p)
    if not tier_ok
        working_tier := f_tier_from_move(up_move_p)
    if not na(swing_sbar) and not na(swing_spx) and i_show_tier
        line.new(swing_sbar, swing_spx, anchor_bar, anchor, color=color.new(color.lime, 0), width=2)
    if i_show_tier
        label.new(anchor_bar, anchor, text="TIER " + str.tostring(sig_pips) + unit_str, style=label.style_label_down, color=color.new(color.lime, 15), textcolor=color.white, size=size.small)
    if i_show_dz
        this_atom = f_atom(working_tier) * pip
        if not na(dz_box)
            box.delete(dz_box)
        dz_box    := box.new(anchor_bar, anchor - this_atom * DZ_LO, anchor_bar + 80, anchor - this_atom * DZ_HI, bgcolor=color.new(color.lime, 75), border_color=color.new(color.lime, 0), border_width=2)
        dz_origin := anchor
        dz_dir    := -1
    au_px   = f_atom(working_tier) * pip
    sl_px   = high + sl_buf
    tp_px   = close - au_px
    be_px   = close - au_px * 0.50
    risk_px = math.max(sl_px - close, pip)
    r_val   = au_px / risk_px
    alert("{\"action\":\"sell\",\"symbol\":\"" + _sym + "\",\"entry\":\"" + str.tostring(close, format.mintick) + "\",\"stop_loss\":\"" + str.tostring(sl_px, format.mintick) + "\",\"take_profit\":\"" + str.tostring(tp_px, format.mintick) + "\",\"message\":\"TIER SHORT " + _sym + " | Entry:" + str.tostring(close, format.mintick) + " SL:" + str.tostring(sl_px, format.mintick) + " TP:" + str.tostring(tp_px, format.mintick) + " BE:" + str.tostring(be_px, format.mintick) + " R:" + str.tostring(r_val, "#.##") + "R\"}", alert.freq_once_per_bar_close)
    swing_origin   := anchor
    swing_sbar     := anchor_bar
    swing_spx      := anchor
    rolling_hi     := high
    rolling_lo     := low
    rolling_hi_bar := bar_index
    rolling_lo_bar := bar_index

// TIER LONG
if bull_tier_cond
    anchor     = rolling_lo
    anchor_bar = rolling_lo_bar
    sig_pips   = math.round(down_move_p)
    if not tier_ok
        working_tier := f_tier_from_move(down_move_p)
    if not na(swing_sbar) and not na(swing_spx) and i_show_tier
        line.new(swing_sbar, swing_spx, anchor_bar, anchor, color=color.new(color.red, 0), width=2)
    if i_show_tier
        label.new(anchor_bar, anchor, text="TIER " + str.tostring(sig_pips) + unit_str, style=label.style_label_up, color=color.new(color.red, 15), textcolor=color.white, size=size.small)
    if i_show_dz
        this_atom = f_atom(working_tier) * pip
        if not na(dz_box)
            box.delete(dz_box)
        dz_box    := box.new(anchor_bar, anchor + this_atom * DZ_HI, anchor_bar + 80, anchor + this_atom * DZ_LO, bgcolor=color.new(color.red, 75), border_color=color.new(color.red, 0), border_width=2)
        dz_origin := anchor
        dz_dir    := 1
    au_px   = f_atom(working_tier) * pip
    sl_px   = low - sl_buf
    tp_px   = close + au_px
    be_px   = close + au_px * 0.50
    risk_px = math.max(close - sl_px, pip)
    r_val   = au_px / risk_px
    alert("{\"action\":\"buy\",\"symbol\":\"" + _sym + "\",\"entry\":\"" + str.tostring(close, format.mintick) + "\",\"stop_loss\":\"" + str.tostring(sl_px, format.mintick) + "\",\"take_profit\":\"" + str.tostring(tp_px, format.mintick) + "\",\"message\":\"TIER LONG " + _sym + " | Entry:" + str.tostring(close, format.mintick) + " SL:" + str.tostring(sl_px, format.mintick) + " TP:" + str.tostring(tp_px, format.mintick) + " BE:" + str.tostring(be_px, format.mintick) + " R:" + str.tostring(r_val, "#.##") + "R\"}", alert.freq_once_per_bar_close)
    swing_origin   := anchor
    swing_sbar     := anchor_bar
    swing_spx      := anchor
    rolling_hi     := high
    rolling_lo     := low
    rolling_hi_bar := bar_index
    rolling_lo_bar := bar_index

if not na(dz_box) and dz_dir != 0 and barstate.islast
    box.set_right(dz_box, bar_index + 30)

// SWING ENTRY
if i_swing_enable and sw_bias_locked and not sw_active and tier_ok and in_bias and barstate.isconfirmed
    sw_atom_px   = f_atom(working_tier) * pip
    prev_body    = math.abs(close[1] - open[1])
    is_prev_bull = close[1] > open[1] and prev_body >= sw_atom_px * 0.50
    is_prev_bear = close[1] < open[1] and prev_body >= sw_atom_px * 0.50

    if sw_bias_dir == 1 and is_prev_bull and close < open
        sw_entry_px   := close
        sw_sl_px      := ar_lo
        sw_tp_px      := i_swing_target == "T25" ? sw_t25 : i_swing_target == "T100" ? sw_t100 : sw_t50
        sw_be_px      := sw_entry_px + (sw_tp_px - sw_entry_px) * 0.50
        sw_active     := true
        sw_t25_hit    := false
        sw_t50_hit    := false
        sw_t100_hit   := false
        risk_px2      = math.max(sw_entry_px - sw_sl_px, pip)
        r_val2        = (sw_tp_px - sw_entry_px) / risk_px2
        alert("{\"action\":\"buy\",\"symbol\":\"" + _sym + "\",\"entry\":\"" + str.tostring(sw_entry_px, format.mintick) + "\",\"stop_loss\":\"" + str.tostring(sw_sl_px, format.mintick) + "\",\"take_profit\":\"" + str.tostring(sw_tp_px, format.mintick) + "\",\"message\":\"SWING LONG " + _sym + " | Entry:" + str.tostring(sw_entry_px, format.mintick) + " SL:" + str.tostring(sw_sl_px, format.mintick) + " TP:" + str.tostring(sw_tp_px, format.mintick) + " BE:" + str.tostring(sw_be_px, format.mintick) + " R:" + str.tostring(r_val2, "#.##") + "R | T25:" + str.tostring(sw_t25, format.mintick) + " T50:" + str.tostring(sw_t50, format.mintick) + " T100:" + str.tostring(sw_t100, format.mintick) + "\"}", alert.freq_once_per_bar_close)
        if i_show_swing
            label.new(bar_index, sw_entry_px, text="SWING\nLONG", style=label.style_label_up, color=color.new(color.orange, 10), textcolor=color.white, size=size.small)

    else if sw_bias_dir == -1 and is_prev_bear and close > open
        sw_entry_px   := close
        sw_sl_px      := ar_hi
        sw_tp_px      := i_swing_target == "T25" ? sw_t25 : i_swing_target == "T100" ? sw_t100 : sw_t50
        sw_be_px      := sw_entry_px - (sw_entry_px - sw_tp_px) * 0.50
        sw_active     := true
        sw_t25_hit    := false
        sw_t50_hit    := false
        sw_t100_hit   := false
        risk_px2      = math.max(sw_sl_px - sw_entry_px, pip)
        r_val2        = (sw_entry_px - sw_tp_px) / risk_px2
        alert("{\"action\":\"sell\",\"symbol\":\"" + _sym + "\",\"entry\":\"" + str.tostring(sw_entry_px, format.mintick) + "\",\"stop_loss\":\"" + str.tostring(sw_sl_px, format.mintick) + "\",\"take_profit\":\"" + str.tostring(sw_tp_px, format.mintick) + "\",\"message\":\"SWING SHORT " + _sym + " | Entry:" + str.tostring(sw_entry_px, format.mintick) + " SL:" + str.tostring(sw_sl_px, format.mintick) + " TP:" + str.tostring(sw_tp_px, format.mintick) + " BE:" + str.tostring(sw_be_px, format.mintick) + " R:" + str.tostring(r_val2, "#.##") + "R | T25:" + str.tostring(sw_t25, format.mintick) + " T50:" + str.tostring(sw_t50, format.mintick) + " T100:" + str.tostring(sw_t100, format.mintick) + "\"}", alert.freq_once_per_bar_close)
        if i_show_swing
            label.new(bar_index, sw_entry_px, text="SWING\nSHORT", style=label.style_label_down, color=color.new(color.orange, 10), textcolor=color.white, size=size.small)

// SWING TARGET MANAGEMENT & EXIT
if i_swing_enable and sw_active and not na(sw_entry_px) and barstate.isconfirmed
    bias_end_h = is_crypto ? 15 : 12

    if hour(time, i_tz) >= bias_end_h
        pnl_px = (close - sw_entry_px) * sw_bias_dir
        alert("{\"action\":\"" + (sw_bias_dir == 1 ? "sell" : "buy") + "\",\"symbol\":\"" + _sym + "\",\"message\":\"SWING EXIT TIME " + _sym + " | PnL:" + str.tostring(pnl_px / pip, "#.##") + unit_str + "\"}", alert.freq_once_per_bar_close)
        sw_active      := false
        sw_bias_locked := false
        sw_bias_dir    := 0
        sw_entry_px    := na

    else if sw_bias_dir == 1 and close < ar_lo
        alert("{\"action\":\"sell\",\"symbol\":\"" + _sym + "\",\"message\":\"SWING SL INVALIDATION " + _sym + " | Price:" + str.tostring(close, format.mintick) + "\"}", alert.freq_once_per_bar_close)
        sw_active      := false
        sw_bias_locked := false
        sw_entry_px    := na

    else if sw_bias_dir == -1 and close > ar_hi
        alert("{\"action\":\"buy\",\"symbol\":\"" + _sym + "\",\"message\":\"SWING SL INVALIDATION " + _sym + " | Price:" + str.tostring(close, format.mintick) + "\"}", alert.freq_once_per_bar_close)
        sw_active      := false
        sw_bias_locked := false
        sw_entry_px    := na

    else if sw_bias_dir == 1
        if not sw_t25_hit and not na(sw_t25) and high >= sw_t25
            sw_t25_hit := true
            alert("{\"action\":\"sell\",\"symbol\":\"" + _sym + "\",\"message\":\"SWING T25 " + _sym + " | Price:" + str.tostring(sw_t25, format.mintick) + "\"}", alert.freq_once_per_bar_close)
            if i_swing_be
                sw_sl_px := sw_be_px
        if not sw_t50_hit and not na(sw_t50) and high >= sw_t50
            sw_t50_hit := true
            alert("{\"action\":\"sell\",\"symbol\":\"" + _sym + "\",\"message\":\"SWING T50 " + _sym + " | Price:" + str.tostring(sw_t50, format.mintick) + "\"}", alert.freq_once_per_bar_close)
            if not i_swing_scale
                sw_active  := false
                sw_entry_px := na
        if not sw_t100_hit and not na(sw_t100) and high >= sw_t100
            sw_t100_hit := true
            alert("{\"action\":\"sell\",\"symbol\":\"" + _sym + "\",\"message\":\"SWING T100 " + _sym + " | Price:" + str.tostring(sw_t100, format.mintick) + "\"}", alert.freq_once_per_bar_close)
            sw_active   := false
            sw_entry_px := na

    else if sw_bias_dir == -1
        if not sw_t25_hit and not na(sw_t25) and low <= sw_t25
            sw_t25_hit := true
            alert("{\"action\":\"buy\",\"symbol\":\"" + _sym + "\",\"message\":\"SWING T25 " + _sym + " | Price:" + str.tostring(sw_t25, format.mintick) + "\"}", alert.freq_once_per_bar_close)
            if i_swing_be
                sw_sl_px := sw_be_px
        if not sw_t50_hit and not na(sw_t50) and low <= sw_t50
            sw_t50_hit := true
            alert("{\"action\":\"buy\",\"symbol\":\"" + _sym + "\",\"message\":\"SWING T50 " + _sym + " | Price:" + str.tostring(sw_t50, format.mintick) + "\"}", alert.freq_once_per_bar_close)
            if not i_swing_scale
                sw_active  := false
                sw_entry_px := na
        if not sw_t100_hit and not na(sw_t100) and low <= sw_t100
            sw_t100_hit := true
            alert("{\"action\":\"buy\",\"symbol\":\"" + _sym + "\",\"message\":\"SWING T100 " + _sym + " | Price:" + str.tostring(sw_t100, format.mintick) + "\"}", alert.freq_once_per_bar_close)
            sw_active   := false
            sw_entry_px := na

bgcolor(pair_supported and in_dz and dz_dir == -1 ? color.new(color.lime, 88) : na, title="Long DZ BG")
bgcolor(pair_supported and in_dz and dz_dir == 1  ? color.new(color.red,  88) : na, title="Short DZ BG")
bgcolor(pair_supported and in_bias  ? color.new(color.teal,   97) : na, title="Bias Window")
bgcolor(pair_supported and in_asian ? color.new(color.yellow, 97) : na, title="Asian 7PM-3AM")

plot(pair_supported and not na(ar_hi) ? ar_hi : na, "Asian High", color=color.new(color.blue, 30), linewidth=2, style=plot.style_linebr)
plot(pair_supported and not na(ar_lo) ? ar_lo : na, "Asian Low",  color=color.new(color.blue, 30), linewidth=2, style=plot.style_linebr)

tier_str = "T" + str.tostring(working_tier) + (tier_ok ? "" : "?")
tier_col = working_tier == 1 ? color.lime : working_tier == 2 ? color.yellow : color.orange
ar_str   = not na(ar_hi) and not na(ar_lo) ? str.tostring(math.round((ar_hi - ar_lo) / pip)) + unit_str : "--"
atom_str = str.tostring(f_atom(working_tier), "#") + unit_str
sess_str = in_bias ? "ACTIVE" : in_asian ? "ASIAN" : "CLOSED"
sess_col = in_bias ? color.lime : in_asian ? color.yellow : color.gray
bias_end = is_crypto ? "3PM" : "12PM"
pair_str = not pair_supported ? "UNSUPPORTED" : _btc?"BTCUSD":_eth?"ETHUSD":_xau?"XAUUSD":_nas?"NAS100":_de30?"DE30":_fr40?"FR40":_hk50?"HK50":_chfjpy?"CHFJPY":_uc?"USDCHF":"EURUSD"
pair_col = not pair_supported ? color.red : color.aqua
sw_str   = not i_swing_enable ? "OFF" : sw_active ? "ACTIVE" : sw_bias_locked ? "BIAS " + (sw_bias_dir == 1 ? "LONG" : "SHORT") : "WAIT"
sw_col   = not i_swing_enable ? color.gray : sw_active ? color.orange : sw_bias_locked ? color.yellow : color.gray
_dt      = str.format("{0,date,yyyyMMdd}", time)
_hm      = str.format("{0,date,HHmm}", time)
state_id = _sym + "_" + _dt + "_" + _hm + "_swing"
valid_str = str.format("{0,date,HH:mm}", time_close)

var table tp = table.new(position.top_right, 2, 10, bgcolor=color.new(color.black, 8), border_width=1, border_color=color.new(color.gray, 50), frame_width=1, frame_color=color.new(color.gray, 30))

if i_show_panel and barstate.islast
    table.cell(tp, 0, 0, "SWING TRAP",  text_color=color.white,  text_size=size.small,  bgcolor=color.new(color.navy, 15), text_halign=text.align_center)
    table.cell(tp, 1, 0, "MP",          text_color=color.orange, text_size=size.small,  bgcolor=color.new(color.navy, 15), text_halign=text.align_center)
    table.cell(tp, 0, 1, "PAIR",        text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 1, pair_str,      text_color=pair_col,     text_size=size.small,  text_halign=text.align_center)
    table.cell(tp, 0, 2, "SESSION",     text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 2, sess_str,      text_color=sess_col,     text_size=size.small,  text_halign=text.align_center)
    table.cell(tp, 0, 3, "BIAS END",    text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 3, bias_end,      text_color=color.teal,   text_size=size.small,  text_halign=text.align_center)
    table.cell(tp, 0, 4, "TIER",        text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 4, tier_str,      text_color=tier_col,     text_size=size.small,  text_halign=text.align_center)
    table.cell(tp, 0, 5, "AR RANGE",    text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 5, ar_str,        text_color=color.silver, text_size=size.small,  text_halign=text.align_center)
    table.cell(tp, 0, 6, "ATOM",        text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 6, atom_str,      text_color=color.aqua,   text_size=size.small,  text_halign=text.align_center)
    table.cell(tp, 0, 7, "SWING",       text_color=color.white,  text_size=size.small,  text_halign=text.align_left)
    table.cell(tp, 1, 7, sw_str,        text_color=sw_col,       text_size=size.small,  text_halign=text.align_center)
    table.cell(tp, 0, 8, "STATE ID",    text_color=color.white,  text_size=size.tiny,   text_halign=text.align_left)
    table.cell(tp, 1, 8, state_id,      text_color=color.yellow, text_size=size.tiny,   text_halign=text.align_center)
    table.cell(tp, 0, 9, "VALID UNTIL", text_color=color.white,  text_size=size.tiny,   text_halign=text.align_left)
    table.cell(tp, 1, 9, valid_str,     text_color=color.white,  text_size=size.tiny,   text_halign=text.align_center)

alertcondition(bear_tier_cond, "SWING TRAP TIER SHORT", "{\"action\":\"sell\",\"symbol\":\"{{ticker}}\",\"entry\":\"{{close}}\",\"stop_loss\":\"\",\"take_profit\":\"\",\"message\":\"TIER SHORT {{ticker}} | Entry:{{close}} | {{timenow}} | TF:{{interval}}\"}")
alertcondition(bull_tier_cond, "SWING TRAP TIER LONG",  "{\"action\":\"buy\",\"symbol\":\"{{ticker}}\",\"entry\":\"{{close}}\",\"stop_loss\":\"\",\"take_profit\":\"\",\"message\":\"TIER LONG {{ticker}} | Entry:{{close}} | {{timenow}} | TF:{{interval}}\"}")
alertcondition(bear_atom_cond, "SWING TRAP ATOM SHORT", "{\"action\":\"sell\",\"symbol\":\"{{ticker}}\",\"entry\":\"{{close}}\",\"stop_loss\":\"\",\"take_profit\":\"\",\"message\":\"ATOM SHORT {{ticker}} | Entry:{{close}} | {{timenow}} | TF:{{interval}}\"}")
alertcondition(bull_atom_cond, "SWING TRAP ATOM LONG",  "{\"action\":\"buy\",\"symbol\":\"{{ticker}}\",\"entry\":\"{{close}}\",\"stop_loss\":\"\",\"take_profit\":\"\",\"message\":\"ATOM LONG {{ticker}} | Entry:{{close}} | {{timenow}} | TF:{{interval}}\"}")
alertcondition(i_swing_enable and sw_active, "SWING TRAP SWING ACTIVE", "SWING ACTIVE {{ticker}} | {{close}}")
alertcondition(i_swing_enable and sw_bias_locked and not na(sw_t50) and ((sw_bias_dir == 1 and high >= sw_t50) or (sw_bias_dir == -1 and low <= sw_t50)), "SWING TRAP T50 HIT", "SWING T50 {{ticker}} | {{close}}")
